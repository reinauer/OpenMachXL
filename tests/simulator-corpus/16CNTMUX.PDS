;----------------------------------- Boolean Equation Segment ------
EQUATIONS

QREG.CLKF = CLK
QREG.RSTF = GND
QREG.SETF = GND

Q0.T := COUNT
      + LOAD * I0 * /Q0
      + LOAD * /I0 * Q0

Q1.T := COUNT * UP * Q0
      + COUNT * /UP * /Q0
      + LOAD * I1 * /Q1
      + LOAD * /I1 * Q1

Q2.T := COUNT * UP * Q0 * Q1
      + COUNT * /UP * /Q0 * /Q1
      + LOAD * I2 * /Q2
      + LOAD * /I2 * Q2

Q3.T := COUNT * UP * Q0 * Q1 * Q2
      + COUNT * /UP * /Q0 * /Q1 * /Q2
      + LOAD * I3 * /Q3
      + LOAD * /I3 * Q3

Q4.T := COUNT * UP * Q0 * Q1 * Q2 * Q3
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3
      + LOAD * I4 * /Q4
      + LOAD * /I4 * Q4

Q5.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4
      + LOAD * I5 * /Q5
      + LOAD * /I5 * Q5

Q6.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5
      + LOAD * I6 * /Q6
      + LOAD * /I6 * Q6

Q7.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 *Q6
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6
      + LOAD * I7 * /Q7
      + LOAD * /I7 * Q7

Q8.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7
      + LOAD * I8 * /Q8
      + LOAD * /I8 * Q8

Q9.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
      + LOAD * I9 * /Q9
      + LOAD * /I9 * Q9

Q10.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8 * Q9
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
        * /Q9
      + LOAD * I10 * /Q10
      + LOAD * /I10 * Q10

Q11.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8 * Q9 * Q10
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
        * /Q9 * /Q10
      + LOAD * I11 * /Q11
      + LOAD * /I11 * Q11

Q12.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8 * Q9 * Q10
         * Q11
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
        * /Q9 * /Q10 * /Q11
      + LOAD * I12 * /Q12
      + LOAD * /I12 * Q12

Q13.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8 * Q9 * Q10
         * Q11 * Q12
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
        * /Q9 * /Q10 * /Q11 * /Q12
      + LOAD * I13 * /Q13
      + LOAD * /I13 * Q13

Q14.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8 * Q9 * Q10
         * Q11 * Q12 * Q13
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
        * /Q9 * /Q10 * /Q11 * /Q12 * /Q13
      + LOAD * I14 * /Q14
      + LOAD * /I14 * Q14

Q15.T := COUNT * UP * Q0 * Q1 * Q2 * Q3 * Q4 * Q5 * Q6 * Q7 * Q8 * Q9 * Q10
         * Q11 * Q12 * Q13 * Q14
      + COUNT * /UP * /Q0 * /Q1 * /Q2 * /Q3 * /Q4 * /Q5 * /Q6 * /Q7 * /Q8
        * /Q9 * /Q10 * /Q11 * /Q12 * /Q13 * /Q14
      + LOAD * I15 * /Q15
      + LOAD * /I15 * Q15

Q16.T := COUNT
      + LOAD * I16 * /Q16
      + LOAD * /I16 * Q16

Q17.T := COUNT * UP * Q16
      + COUNT * /UP * /Q16
      + LOAD * I17 * /Q17
      + LOAD * /I17 * Q17

Q18.T := COUNT * UP * Q16 * Q17
      + COUNT * /UP * /Q16 * /Q17
      + LOAD * I18 * /Q18
      + LOAD * /I18 * Q18

Q19.T := COUNT * UP * Q16 * Q17 * Q18
      + COUNT * /UP * /Q16 * /Q17 * /Q18
      + LOAD * I19 * /Q19
      + LOAD * /I19 * Q19

Q20.T := COUNT * UP * Q16 * Q17 * Q18 * Q19
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19
      + LOAD * I20 * /Q20
      + LOAD * /I20 * Q20

Q21.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20
      + LOAD * I21 * /Q21
      + LOAD * /I21 * Q21

Q22.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21
      + LOAD * I22 * /Q22
      + LOAD * /I22 * Q22

Q23.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22
      + LOAD * I23 * /Q23
      + LOAD * /I23 * Q23

Q24.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
      + LOAD * I24 * /Q24
      + LOAD * /I24 * Q24

Q25.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24
      + LOAD * I25 * /Q25
      + LOAD * /I25 * Q25

Q26.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
         * Q25
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24 * /Q25
      + LOAD * I26 * /Q26
      + LOAD * /I26 * Q26

Q27.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
         * Q25 * Q26
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24 * /Q25 * /Q26
      + LOAD * I27 * /Q27
      + LOAD * /I27 * Q27

Q28.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
         * Q25 * Q26 * Q27
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24 * /Q25 * /Q26 * /Q27
      + LOAD * I28 * /Q28
      + LOAD * /I28 * Q28

Q29.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
         * Q25 * Q26 * Q27 * Q28
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24 * /Q25 * /Q26 * /Q27 * /Q28
      + LOAD * I29 * /Q29
      + LOAD * /I29 * Q29

Q30.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
         * Q25 * Q26 * Q27 * Q28 * Q29
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24 * /Q25 * /Q26 * /Q27 * /Q28 * /Q29
      + LOAD * I30 * /Q30
      + LOAD * /I30 * Q30

Q31.T := COUNT * UP * Q16 * Q17 * Q18 * Q19 * Q20 * Q21 * Q22 * Q23 * Q24
         * Q25 * Q26 * Q27 * Q28 * Q29 * Q30
      + COUNT * /UP * /Q16 * /Q17 * /Q18 * /Q19 * /Q20 * /Q21 * /Q22 * /Q23
        * /Q24 * /Q25 * /Q26 * /Q27 * /Q28 * /Q29 * /Q30
      + LOAD * I31 * /Q31
      + LOAD * /I31 * Q31

