CHIP F00015 MACH435
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? I6
PIN ? O0 REG
PIN ? O1 REG
PIN ? O2 REG
PIN ? O3 REG
PIN ? O4
PIN ? O5 LATCHED
PIN ? O6 LATCHED
PIN ? B0
EQUATIONS
O0 = I2*/I1 + /I1*I3*/I5 + I1
O0.CLKF = CLK
O1 = (I3 + /I0*I5*I2 + I5) * (I2 + I3*/I6*/O0)
O1.CLKF = CLK
O2 := /I2 :+: /I3*O0
O2.CLKF = I0*I6
O3 = (/I4*I1) * (/I6*I1)
O3.CLKF = CLK
O3.SETF = /I5
O4 = O2*O0*I1 + /I1
O5 = O1
O5.CLKF = CLK
O5.SETF = I1*I0
O6 *= I4
O6.RSTF = I0*/I3*I5
IF (I1*/I5*I0) THEN
BEGIN
B0 = I1 + /I3*/I6 + /I1*I5*I2
END
ELSE
BEGIN
B0 = I1*/I5*I4 + /I2*I6*/I1 + /I1*I4
END
