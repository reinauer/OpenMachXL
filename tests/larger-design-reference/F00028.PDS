CHIP F00028 MACH211
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? I6
PIN ? I7
PIN ? I8
PIN ? O0 REG
PIN ? O1 REG
NODE ? N2
NODE ? N3
PIN ? XN2
PIN ? C0
EQUATIONS
O0 := /I3 :+: I2*I5
O0.CLKF = CLK
O0.RSTF = I2*I5*I8
O0.SETF = I6*/I4*I2
O1 := I0 + I4*I8*I3
O1.CLKF = CLK
O1.SETF = I4
O1.TRST = I7*/I3*I2
N2 = /O0 :+: O0
N3 = I3*I6
XN2 = N2 * I1
CASE (I0,I1)
BEGIN
0: BEGIN C0 = I5*I3*I4 END
1: BEGIN C0 = I7*I6*I2 END
3: BEGIN C0 = I3*/I7 + I6*I2 + I2 END
2: BEGIN C0 = I4*I2*I5 + /I5*I7*/I2 + /I7*/I6*/I4 END
END
