CHIP F00024 MACH445
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
PIN ? C0
EQUATIONS
O0 := I2*/I0 + /I0*/I5 + /I1*I0*/I2
O0.CLKF = I4*I3
CASE (I0,I1)
BEGIN
0: BEGIN C0 = I4 + /I3 + I5 END
2: BEGIN C0 = /I5*I3 + /I5*/I3*I2 END
OTHERWISE: BEGIN C0 = /I5 + I3*I2 END
END
