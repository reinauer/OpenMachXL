CHIP F00019 MACH120
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? I6
PIN ? O0 REG
PIN ? O1 REG
PIN ? O2 REG
PIN ? O3 REG
NODE ? N4
PIN ? O5 REG
PIN ? O6
PIN ? O7
PIN ? O8
PIN ? O9
PIN ? O10 REG
PIN ? XN4
PIN ? B0
EQUATIONS
O0 = /I6*/I5 :+: I2*I3*I1
O0.CLKF = CLK
O0.SETF = I0
O1 := I5*I1*/I0 + I0*I3*/I6 + I3*/I5*I0
O1.CLKF = CLK
O1.SETF = I4*/I3
O2 = I1 :+: /I5*/I2*I0
O2.CLKF = CLK
O3 = I1*/I4*/I2 + I0*O2*/I6
O3.CLKF = CLK
N4 = /I1*/I4
O5 = /I3*/I0*O3 :+: /O2*I6
O5.CLKF = CLK
O5.SETF = /I6
O6 = I4*/O2 + O1*O3*/O0 + I5*/I1
O7 = O6*I0 + I4*O2*/I6
O8 = /I6 :+: I5*N4
O9 = I5*N4 + O6
O10 := O6 + O7*/O9 + /O9*/O1
O10.CLKF = CLK
XN4 = N4 * I0
IF (I5*I2) THEN
BEGIN
B0 = I5*I0*I6 + I0*I3*/I2
END
ELSE
BEGIN
B0 = /I1*/I6*I2 + I2*I6*I4 + I5*/I2
END
