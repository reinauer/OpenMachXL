CHIP F00013 MACH220
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? Q0 REG
PIN ? Q1 REG
PIN ? Z
STATE
MEALY_MACHINE
CLKF = CLK
S0 = /Q0*/Q1
S1 = Q0*/Q1
S2 = /Q0*Q1
S3 = Q0*Q1
S0 := I0 -> S0
S1 := I0 -> S2
        +-> S1
S2 := I1 -> S0
S3 := I1 -> S0
        + /I1 -> S0
S0.OUTF = I1 -> Z
S1.OUTF = I1 -> /Z
        + /I1 -> /Z
S2.OUTF = I1 -> Z
S3.OUTF = I1 -> /Z
