CHIP F00038 MACH215
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0 REG
PIN ? O1 LATCHED
PIN ? O2 REG
PIN ? O3 LATCHED
EQUATIONS
O0 := /I1*I3 + I0 + I3
O0.RSTF = I0*I2
O1 = (I3*/I1 + /I0*I2 + /O0) * (/I3*/O0*/I1 + I3*O0*I2 + /I3)
O1.CLKF = CLK
O2 = O0 :+: /I3*I1*I2
O2.CLKF = CLK
O2.RSTF = /I1*/I2
O2.TRST = I0*I3*I2
O3 *= I3 + O0*/O2*/O1 + I2
O3.CLKF = CLK
O3.TRST = /I2
