CHIP F00047 MACH120
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0
PIN ? O1 REG
PIN ? O2
PIN ? O3
PIN ? O4 REG
PIN ? O5 REG
PIN ? O6 REG
EQUATIONS
O0 = I3
O0.TRST = /I2*/I1*/I0
O1 := /I3*/O0
O1.CLKF = CLK
O1.SETF = /I0*I2*I1
O2 = (I0*/I3*I2) * (I0 + O1*I1 + I2*I3)
