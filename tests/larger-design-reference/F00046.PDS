CHIP F00046 MACH120
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? Q0 REG
PIN ? Q1 REG
PIN ? Z REG
STATE
MOORE_MACHINE
DEFAULT_BRANCH HOLD_STATE
CLKF = CLK
S0 = /Q0*/Q1
S1 = Q0*/Q1
S2 = /Q0*Q1
S3 = Q0*Q1
S0 := /I1 -> S0
S1 := I2 -> S2
        + /I2 -> S0
        +-> S1
S2 := G1 -> S1
        +-> S2
S3 := G0 -> S1
S0.OUTF = Z
S2.OUTF = /Z
S3.OUTF = Z
CONDITIONS
G0 = I2*I0
G1 = I2*/I0
G2 = /I2
