;This Moore Machine has 6 states, two input bits, and three output bits.
;It rotates data at two different frequencies, and in both directions.
;CASE constructs allows having more than one state-machine in one
;design.

;---------------------------------- Declaration Segment ------------
TITLE    State Machine using CASE statements
PATTERN  A
REVISION 1.0
AUTHOR   J. ENGINEER
COMPANY  AMD
DATE     6/7/94

CHIP   REG_MOORE   MACH435

;---------------------------------- PIN Declarations ---------------
PIN  ?          CLOCK                                         
PIN  ?          INB                                            ; INPUT
PIN  ?          INA                                            ; INPUT 
PIN  ?          OUT[2..0]            REGISTERED      ; OUTPUT - State outputs
PIN  ?          BIT[2..0]            REGISTERED      ; OUTPUT - State bits
PIN  ?          RESET


; State machine inputs

STRING GO  '(INA * INB)'
STRING BACK '(INA * /INB)'
STRING JUMP '(/INA * INB)'

;To assign values to states

STRING STATE0 '#B000'           ; 
STRING STATE1 '#B001'           ;  
STRING STATE2 '#B011'           ;
STRING STATE3 '#B111'           ; 
STRING STATE4 '#B110'           ;
STRING STATE5 '#B100'           ; 

STRING STATE_BITS 'BIT[2..0]'
STRING STATE_OUT  'OUT[2..0]'

;to assign values to output bits

STRING S_OUT0 '#B000'          
STRING S_OUT1 '#B001'          
STRING S_OUT2 '#B010'          
STRING S_OUT3 '#B011'        
STRING S_OUT4 '#B100'         
STRING S_OUT5 '#B101'         


EQUATIONS

OUT[2..0].RSTF=RESET
OUT[2..0].CLKF=CLOCK
BIT[2..0].RSTF=RESET
BIT[2..0].CLKF=CLOCK

;State2 is the first argument in the CASE loop because it is the only one
;which will cause the state bits to be active high.  This happens when the
;first IF loop assigns all highs to the state bits.

CASE (STATE_BITS) BEGIN

 STATE2:      
        BEGIN  

        if (ina*/ina) then
        begin
        STATE_OUT=#b111  ; Dummy argument to make output bits active high.
        end

        STATE_OUT=S_OUT2 
        
             IF (GO) THEN         
               BEGIN
               STATE_BITS=STATE3 ;This statement causes the state bits to be
               END               ;active high because state3 = #b111
             ELSE
               BEGIN
               IF (JUMP) THEN        
                 BEGIN 
                 STATE_BITS=STATE4
                 END
               ELSE
                 BEGIN
                 IF (BACK) THEN        
                   BEGIN 
                   STATE_BITS=STATE1
                   END
                 ELSE
                   BEGIN 
                   STATE_BITS=STATE0
                   END
                 END
             END
         END
 
 
;Alternate way of writing the IF loops. 

 STATE3:      
        BEGIN

 STATE_OUT=S_OUT3

             IF (GO * /(BACK + JUMP)) THEN         
               BEGIN
               STATE_BITS=STATE4
               END
               IF (JUMP * /(GO+BACK)) THEN        
                 BEGIN 
                 STATE_BITS=STATE5
                 END
                 IF (BACK * /(GO + JUMP)) THEN        
                   BEGIN 
                   STATE_BITS=STATE2
                   END
                 IF (/(BACK + GO + JUMP)) THEN 
                   BEGIN 
                   STATE_BITS=STATE3
                   END
         END
 
 STATE0:        
        BEGIN  

        STATE_OUT=S_OUT0 

             IF (GO) THEN         
               BEGIN
               STATE_BITS=STATE1
               END
             ELSE
               BEGIN
               IF (JUMP) THEN        
                 BEGIN 
                 STATE_BITS=STATE2
                 END
               ELSE
                 BEGIN
                 IF (BACK) THEN        
                   BEGIN 
                   STATE_BITS=STATE5
                   END
                 ELSE
                   BEGIN 
                   STATE_BITS=STATE0
                   END
                 END
             END
         END
 STATE1:      
        BEGIN  

        STATE_OUT=S_OUT1 

             IF (GO) THEN         
               BEGIN
               STATE_BITS=STATE2
               END
             ELSE
               BEGIN
               IF (JUMP) THEN        
                 BEGIN 
                 STATE_BITS=STATE3
                 END
               ELSE
                 BEGIN
                 IF (BACK) THEN        
                   BEGIN 
                   STATE_BITS=STATE0
                   END
                 ELSE
                   BEGIN 
                   STATE_BITS=STATE0
                   END
                 END
             END
         END
         
          
 STATE4:      
        BEGIN  

        STATE_OUT=S_OUT4 

             IF (GO) THEN         
               BEGIN
               STATE_BITS=STATE5
               END
             ELSE
               BEGIN
               IF (JUMP) THEN        
                 BEGIN 
                 STATE_BITS=STATE0
                 END
               ELSE
                 BEGIN
                 IF (BACK) THEN        
                   BEGIN 
                   STATE_BITS=STATE3
                   END
                 ELSE
                   BEGIN 
                   STATE_BITS=STATE4
                   END
                 END
             END
         END

 STATE5:      
        BEGIN  

        STATE_OUT=S_OUT5 

             IF (GO) THEN         
               BEGIN
               STATE_BITS=STATE0
               END
             ELSE
               BEGIN
               IF (JUMP) THEN        
                 BEGIN 
                 STATE_BITS=STATE1
                 END
               ELSE
                 BEGIN
                 IF (BACK) THEN        
                   BEGIN 
                   STATE_BITS=STATE4
                   END
                 ELSE
                   BEGIN 
                   STATE_BITS=STATE5
                   END
                 END
             END
         END

END

;----------------------------------- Simulation Segment ------------

SIMULATION 
TRACE_ON  RESET OUT[2..0] BIT[2..0] INA INB CLOCK 

SETF RESET
SETF /RESET

;---------------Condition "GO"
SETF INB INA

CHECK /OUT[2..0]
FOR X:= 1 TO 4 DO
BEGIN
CLOCKF CLOCK
END
CHECK OUT[2..0]= #B011

;--------------Condition "BACK"
SETF /INB INA

FOR X:= 1 TO 3 DO
BEGIN
CLOCKF CLOCK
END

CHECK OUT[2..0]= #B010

;------------Condition "JUMP"

SETF INB /INA
FOR X:= 1 TO 3 DO
BEGIN
CLOCKF CLOCK
END
CHECK OUT[2..0]= #B101
 
;------------Undefined condition
SETF /INA /INB
FOR X:= 1 TO 2 DO
BEGIN
CLOCKF CLOCK
END

TRACE_OFF
