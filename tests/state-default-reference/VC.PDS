CHIP VC MACH355
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? Q0 REG
PIN ? Q1 REG
STATE
MOORE_MACHINE
DEFAULT_BRANCH HOLD_STATE
CLKF = CLK
S0 = /Q0*/Q1
S1 = Q0*/Q1
S2 = /Q0*Q1
S3 = Q0*Q1
S0 := I2 -> S1
S1 := I2 -> S1 +-> S0
S2 := I1 -> S1 + G3 -> S0
S3 := I2 -> S1 +-> S3
CONDITIONS
G3 = /I1*I0
