;PALASM Design Description
; pds2v test: the NODE must be placed where the logic allocator can feed it.
; Block B is full.  In block A, M0..M7 are all driven except M3 (pin 43,
; unused): C0..C7 cannot give 7 + 2 clusters.  M8..M15 have M12 and M15 on
; input-only pins, and the 2-cluster NODE fits there.
; EXPECT-EXIT: 0
; EXPECT: node PAR4 -> block A (macrocell IO15, pin 15 is an input)

CHIP     ALLOC  MACH111
PIN  10  IN0
PIN  32  IN1
PIN  13  IN2
PIN  33  IN3
PIN  18  IN4                    ; M12: input only
PIN  21  IN5                    ; M15: input only
PIN  2   A0   COMBINATORIAL
PIN  3   A1   COMBINATORIAL
PIN  4   A2   COMBINATORIAL
PIN  6   A3   COMBINATORIAL
PIN  7   A4   COMBINATORIAL
PIN  8   A5   COMBINATORIAL
PIN  9   A6   COMBINATORIAL
PIN  14  A7   COMBINATORIAL
PIN  15  A8   COMBINATORIAL
PIN  16  A9   COMBINATORIAL
PIN  17  A10  COMBINATORIAL
PIN  19  A11  COMBINATORIAL
PIN  20  A12  COMBINATORIAL
PIN  24  B0   COMBINATORIAL
PIN  25  B1   COMBINATORIAL
PIN  26  B2   COMBINATORIAL
PIN  27  B3   COMBINATORIAL
PIN  28  B4   COMBINATORIAL
PIN  29  B5   COMBINATORIAL
PIN  30  B6   COMBINATORIAL
PIN  31  B7   COMBINATORIAL
PIN  36  B8   COMBINATORIAL
PIN  37  B9   COMBINATORIAL
PIN  38  B10  COMBINATORIAL
PIN  39  B11  COMBINATORIAL
PIN  40  B12  COMBINATORIAL
PIN  41  B13  COMBINATORIAL
PIN  42  B14  COMBINATORIAL
PIN  43  B15  COMBINATORIAL
NODE ?   PAR4  COMBINATORIAL   ; 8 product terms = 2 clusters

EQUATIONS
PAR4 = IN0 :+: IN1 :+: IN2 :+: IN3
A0 = PAR4 * IN4
A1 = IN0 * IN5
A2 = IN0 * IN5
A3 = IN0 * IN5
A4 = IN0 * IN5
A5 = IN0 * IN5
A6 = IN0 * IN5
A7 = IN0 * IN5
A8 = IN0 * IN5
A9 = IN0 * IN5
A10 = IN0 * IN5
A11 = IN0 * IN5
A12 = IN0 * IN5
B0 = IN1
B1 = IN1
B2 = IN1
B3 = IN1
B4 = IN1
B5 = IN1
B6 = IN1
B7 = IN1
B8 = IN1
B9 = IN1
B10 = IN1
B11 = IN1
B12 = IN1
B13 = IN1
B14 = IN1
B15 = IN1
