;PALASM Design Description
; pds2v test: the NODE must be placed where the logic allocator can feed it.
; Block B is full.  In block A, M0..M7 are all driven except M3 (pin 43,
; unused): C0..C7 cannot give 7 + 2 clusters.  M8..M15 have M12 and M15 on
; input-only pins, and the 2-cluster NODE fits there.
; EXPECT-EXIT: 0
; EXPECT: node PAR4 -> block A (macrocell IO15, pin 15 is an input)

CHIP     ALLOC  MACH111
PIN  4   IN0
PIN  26  IN1
PIN  7   IN2
PIN  27  IN3
PIN  12  IN4                    ; M12: input only
PIN  15  IN5                    ; M15: input only
PIN  40  A0   COMBINATORIAL
PIN  41  A1   COMBINATORIAL
PIN  42  A2   COMBINATORIAL
PIN  44  A3   COMBINATORIAL
PIN  1   A4   COMBINATORIAL
PIN  2   A5   COMBINATORIAL
PIN  3   A6   COMBINATORIAL
PIN  8   A7   COMBINATORIAL
PIN  9   A8   COMBINATORIAL
PIN  10  A9   COMBINATORIAL
PIN  11  A10  COMBINATORIAL
PIN  13  A11  COMBINATORIAL
PIN  14  A12  COMBINATORIAL
PIN  18  B0   COMBINATORIAL
PIN  19  B1   COMBINATORIAL
PIN  20  B2   COMBINATORIAL
PIN  21  B3   COMBINATORIAL
PIN  22  B4   COMBINATORIAL
PIN  23  B5   COMBINATORIAL
PIN  24  B6   COMBINATORIAL
PIN  25  B7   COMBINATORIAL
PIN  30  B8   COMBINATORIAL
PIN  31  B9   COMBINATORIAL
PIN  32  B10  COMBINATORIAL
PIN  33  B11  COMBINATORIAL
PIN  34  B12  COMBINATORIAL
PIN  35  B13  COMBINATORIAL
PIN  36  B14  COMBINATORIAL
PIN  37  B15  COMBINATORIAL
NODE ?   PAR4  COMBINATORIAL   ; 8 product terms = 2 clusters

EQUATIONS
PAR4 = IN0 :+: IN1 :+: IN2 :+: IN3
A0 = PAR4 * IN4
A1 = IN0 * IN5
A2 = IN0 * IN5
A3 = IN0 * IN5
A4 = IN0 * IN5
A5 = IN0 * IN5
A6 = IN0 * IN5
A7 = IN0 * IN5
A8 = IN0 * IN5
A9 = IN0 * IN5
A10 = IN0 * IN5
A11 = IN0 * IN5
A12 = IN0 * IN5
B0 = IN1
B1 = IN1
B2 = IN1
B3 = IN1
B4 = IN1
B5 = IN1
B6 = IN1
B7 = IN1
B8 = IN1
B9 = IN1
B10 = IN1
B11 = IN1
B12 = IN1
B13 = IN1
B14 = IN1
B15 = IN1
