LINE #   |----+----1----+----2----+----3----+----4----+----5----+----6----+
   1     |;PALASM Design Description
   2     |; pds2v test: purely combinatorial address decoder.
   3     |; Exercises STRING macros, multi-line equations, active-low left sides,
   4     |; XOR/XNOR, VCC/GND, an output enable (.TRST) and a read-back of an output.
   5     |; EXPECT-EXIT: 0
   6     |; EXPECT: warning: SPARE (pin 13) is never used
   7     |
   8     |TITLE    pds2v test decoder
   9     |PATTERN  decoder
  10     |REVISION 1
  11     |AUTHOR   test
  12     |COMPANY  none
  13     |DATE     1995-10-01
  14     |CHIP     DEC  MACH111
  15     |
  16     |PIN  10  AS_N                     ; dedicated inputs
  17     |PIN  32  RW
  18     |PIN  2   A31
  19     |PIN  3   A30
  20     |PIN  4   A29
  21     |PIN  5   A28
  22     |PIN  6   FC2
  23     |PIN  7   FC1
  24     |PIN  19  SPARE
  25     |PIN  8   ROM_N      COMBINATORIAL
  26     |PIN  9   RAM_N      COMBINATORIAL
  27     |PIN  14  IO_N       COMBINATORIAL
  28     |PIN  15  ANY_N      COMBINATORIAL ; reads back ROM_N, RAM_N, IO_N
  29     |PIN  16  PAR        COMBINATORIAL ; A31 xor A30 xor A29 xor A28
  30     |PIN  17  SAME       COMBINATORIAL ; A31 xnor A30
  31     |PIN  24  HI         COMBINATORIAL ; constant 1
  32     |PIN  25  LO         COMBINATORIAL ; constant 0
  33     |PIN  26  DOUT       COMBINATORIAL ; three-state, enabled on read
  34     |PIN  27  OE_N       COMBINATORIAL
  35     |
  36     |STRING  CYC    '( /AS_N * FC2 )'
  37     |STRING  ROMSEL '/A31 * /A30'
  38     |
  39     |EQUATIONS
  40     |/ROM_N =  
  40  s1 |( /AS_N * FC2 )
  40     |              *  
  40  s1 |/A31 * /A30
  40     |                                  ; active low: ROM_N = NOT(...)
  41     |/RAM_N =  
  41  s1 |( /AS_N * FC2 )
  41     |              * /A31 * A30
  42     |       +  
  42  s1 |( /AS_N * FC2 )
  42     |              * A31 * /A30 * /A29
  43     |/IO_N  =  
  43  s1 |( /AS_N * FC2 )
  43     |
  44     |       * A31 * A30 * A29        ; continuation over several lines
  45     |ANY_N  = ROM_N * RAM_N * IO_N
  46     |PAR    = (A31 :+: A30) :+: (A29 :+: A28)
  47     |SAME   = A31 :*: A30
  48     |HI     = VCC
  49     |LO     = GND
  50     |DOUT   = FC1
  51     |DOUT.TRST = RW * /AS_N
  52     |OE_N   = /( RW * /AS_N )

