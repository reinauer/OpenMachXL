CHIP MIXPROBE MACH355
PIN 129 A
PIN 130 B
PIN 131 C
PIN 8 K0
PIN 9 K1
NODE ? N
PIN ? Q0
PIN ? Q1 REG
PIN ? Q2 REG
PIN ? Q3 LATCHED
EQUATIONS
N=A*B+C
Q0=N*B+/A
Q1:=A*B+/A*C
Q2.T=A*Q2
Q3*=A+B
Q1.CLKF=/K1
Q1.SETF=A
Q2.CLKF=K1
Q2.RSTF=A
Q2.SETF=GND
Q3.CLKF=/K1
Q3.SETF=B
Q0.TRST=A*B
Q1.TRST=/A
