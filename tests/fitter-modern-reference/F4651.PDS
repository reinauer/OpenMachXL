CHIP MIXPROBE MACH465
PIN 190 A
PIN 191 B
PIN 192 C
PIN 187 K0
PIN 74 K1
NODE ? N
PIN ? Q0
PIN ? Q1 REG
PIN ? Q2 REG
PIN ? Q3 LATCHED
EQUATIONS
N=A*B+C
Q0=N*B+/A
Q1:=A*B+/A*C
Q2.T=A*B+C
Q3*=A:+:C
Q1.CLKF=K1
Q1.RSTF=A*B
Q2.CLKF=/K0
Q3.CLKF=K1
Q3.RSTF=GND
Q3.SETF=GND
Q0.TRST=A*B
Q1.TRST=/A
