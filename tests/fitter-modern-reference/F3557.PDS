CHIP MIXPROBE MACH355
PIN 129 A
PIN 130 B
PIN 131 C
PIN 8 K0
PIN 9 K1
NODE ? N
PIN ? Q0
PIN ? Q1 REG
PIN ? Q2 REG
PIN ? Q3 LATCHED
GROUP MACH_SEG_A Q0 Q1 Q2 Q3 N
EQUATIONS
N=A*B+C
Q0=N*B+/A
Q1:=A+B
Q2.T=A:+:B
Q3*=B
Q1.CLKF=K0
Q2.CLKF=K0
Q2.SETF=B
Q3.CLKF=/K0
Q3.SETF=GND
Q0.TRST=A*B
Q1.TRST=/A
