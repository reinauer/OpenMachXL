;This Moore Machine has 6 states, two input bits, and three output bits.
;It rotates data at two different frequencies, and in both directions.
;MACHXL Design Description

;---------------------------------- Declaration Segment ------------
TITLE    MOORE MACHINE
PATTERN  A
REVISION 1.0
AUTHOR   J. ENGINEER
COMPANY  AMD
DATE     6/7/94

CHIP   REG_MOORE   MACH231

;---------------------------------- PIN Declarations ---------------
PIN  ?          CLOCK                                          ; INPUT
PIN  ?          INA                                            ; INPUT
PIN  ?          INB 
PIN  ?          OUT[2..0]                 REGISTERED                ; OUTPUT
PIN  ?          BIT[2..0]                 REGISTERED                ; OUTPUT
PIN  ?          RESET

;Strings for illegal state recovery

STRING ST0 '(/BIT[2] * /BIT[1] * /BIT[0])'   
STRING ST1 '(/BIT[2] * /BIT[1] *  BIT[0])'
STRING ST2 '(/BIT[2] *  BIT[1] * /BIT[0])'  
STRING ST3 '(/BIT[2] *  BIT[1] *  BIT[0])'  
STRING ST4 '( BIT[2] * /BIT[1] * /BIT[0])'  
STRING ST5 '( BIT[2] * /BIT[1] *  BIT[0])'  

EQUATIONS

OUT[2..0].RSTF=RESET
OUT[2..0].CLKF=CLOCK

BIT[2..0].RSTF=RESET
BIT[2..0].CLKF=CLOCK

;-----Illegal State Recovery------------
/BIT[0] = /(ST0 + ST1 + ST2 + ST3 + ST4 + ST5)
/BIT[1] = /(ST0 + ST1 + ST2 + ST3 + ST4 + ST5)
/BIT[2] = /(ST0 + ST1 + ST2 + ST3 + ST4 + ST5)
;--------------------------------------------

;-----------------------------------State Segment ------------------
STATE
MOORE_MACHINE

;------state assignments-------------

STATE0 = /BIT[2] * /BIT[1] * /BIT[0]
STATE1 = /BIT[2] * /BIT[1] *  BIT[0] 
STATE2 = /BIT[2] *  BIT[1] *  BIT[0] 
STATE3 =  BIT[2] *  BIT[1] *  BIT[0] 
STATE4 =  BIT[2] *  BIT[1] * /BIT[0] 
STATE5 =  BIT[2] * /BIT[1] * /BIT[0] 


;--TRANSITION EQUATIONS------------------

STATE0    :=  GO         -> STATE1
             +JUMP       -> STATE2
             +BACK       -> STATE5

STATE1    :=  GO         -> STATE2
             +JUMP       -> STATE3
             +BACK       -> STATE0
          
STATE2    :=  GO         -> STATE3
             +JUMP       -> STATE4
             +BACK       -> STATE1
          
STATE3    :=  GO         -> STATE4
             +JUMP       -> STATE5
             +BACK       -> STATE2
          
STATE4    :=  GO         -> STATE5
             +JUMP       -> STATE0
             +BACK       -> STATE3

STATE5    :=  GO         -> STATE1
             +JUMP       -> STATE2
             +BACK       -> STATE4

;-------OUTPUT EQUATIONS----------------------

STATE0.OUTF    =  /OUT[2] * /OUT[1] * /OUT[0]
STATE1.OUTF    =  /OUT[2] * /OUT[1] *  OUT[0]
STATE2.OUTF    =  /OUT[2] *  OUT[1] * /OUT[0]
STATE3.OUTF    =  /OUT[2] *  OUT[1] *  OUT[0]
STATE4.OUTF    =   OUT[2] * /OUT[1] * /OUT[0]
STATE5.OUTF    =   OUT[2] * /OUT[1] *  OUT[0]

;--------CONDITION EQUATIONS----------------

CONDITIONS

GO =   INB *  INA
BACK = INB * /INA
JUMP= /INB *  INA

;----------------------------------- Simulation Segment ------------

SIMULATION 

TRACE_ON  RESET OUT[2..0] BIT[2..0] INA INB CLOCK 

SETF RESET
SETF /RESET

;Condition "GO"
SETF INB INA

CHECK STATE0
FOR X:= 1 TO 4 DO
BEGIN
CLOCKF CLOCK
END
CHECK STATE4

;Condition "JUMP"
SETF /INB INA

FOR X:= 1 TO 3 DO
BEGIN
CLOCKF CLOCK
END

CHECK STATE4

;Condition "BACK"

SETF INB /INA
FOR X:= 1 TO 3 DO
BEGIN
CLOCKF CLOCK
END
CHECK STATE1

SETF /INA /INB
FOR X:= 1 TO 2 DO
BEGIN
CLOCKF CLOCK
END


TRACE_OFF
