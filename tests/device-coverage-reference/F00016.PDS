CHIP F00016 MACH130
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? O0 REG
PIN ? O1 REG
PIN ? O2
PIN ? O3 REG
PIN ? B0
EQUATIONS
O0 = /I2*I3
O0.CLKF = CLK
O0.SETF = I1*I3*/I2
O1 := (I4*/I3*I0) * (/I1*I0 + I1*I4*I0 + O0*I3*I2)
O1.CLKF = CLK
O2 = I0*/O1 :+: I4
O3 = /I4
O3.CLKF = CLK
O3.RSTF = /I1
IF (I2*I1*I0) THEN
BEGIN
B0 = I4 + I0*I2
END
ELSE
BEGIN
B0 = I4
END
