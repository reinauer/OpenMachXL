CHIP F00011 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
NODE ? N1 REG
PIN ? O2 REG
PIN ? O3 REG
PIN ? XN1
PIN ? B0
EQUATIONS
O0 = I3*I4*/I1 + I4
O0.CLKF = CLK
O0.RSTF = /I4
O0.SETF = /I5*/I0
N1 := /I1*/I2*I5 + I0*/I1*O0
O2 := I4*I5*I2 :+: I4*/N1
O2.CLKF = CLK
O2.TRST = I3*/I0
O3 := I2*I4 + I1*N1
O3.CLKF = CLK
XN1 = N1 * I3
IF (I3*/I1) THEN
BEGIN
B0 = I0*I5 + /I1
END
ELSE
BEGIN
B0 = /I1*I5*I2
END
