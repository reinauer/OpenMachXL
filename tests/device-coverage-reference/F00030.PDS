CHIP F00030 MACH445
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? O0
NODE ? N1 REG
PIN ? O2
NODE ? N3
PIN ? O4 REG
PIN ? XN1
PIN ? XN3
PIN ? B0
EQUATIONS
O0 = I1 :+: I0*I1*I2
N1 := I1 + I2 + O0*I2*I1
N1.CLKF = CLK
O2 = /I0*N1
N3 = /O2*O0*I2
O4 := (N1*N3) * (I0)
XN1 = N1 * I1
XN3 = N3 * I1
IF (/I2) THEN
BEGIN
B0 = /I1 + I1 + I0
END
ELSE
BEGIN
B0 = I0*/I2*/I1 + I2*I1*/I0
END
