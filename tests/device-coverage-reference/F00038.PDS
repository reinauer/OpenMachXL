CHIP F00038 MACH130
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
PIN ? O1 REG
PIN ? O2
PIN ? C0
EQUATIONS
O0 := /I1*I4 :+: /I2*I0*/I3
O0.CLKF = CLK
O0.RSTF = I1*/I0
O1 = /O0*I0*I3 + I0*/I4 + I2
O1.CLKF = CLK
O1.RSTF = /I2
O1.TRST = /I0
O2 = I4*/O0*O1 :+: /I2
O2.TRST = /I4*/I3*/I2
CASE (I0,I1)
BEGIN
1: BEGIN C0 = I2 + I3 + /I4 END
3: BEGIN C0 = I3*I2*I4 + /I4 END
2: BEGIN C0 = I4*I2*I3 + I2*/I4*I5 + /I5*I4 END
0: BEGIN C0 = I5*I3*/I4 + I4*/I3*I5 END
END
