CHIP F00025 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0 REG
PIN ? O1 REG
NODE ? N2
PIN ? O3
PIN ? XN2
PIN ? B0
EQUATIONS
O0 := /I3*I1*I2 :+: I1
O0.CLKF = CLK
O1 = /I0*I3*/O0
O1.CLKF = CLK
N2 = /O0 + /I2
O3 = I1
O3.TRST = I2
XN2 = N2 * I1
IF (I3*I0) THEN
BEGIN
B0 = /I0
END
ELSE
BEGIN
B0 = /I0*/I3*I1 + /I3 + I0
END
