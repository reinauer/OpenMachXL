CHIP F00039 MACH220
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? O0 REG
NODE ? N1
PIN ? XN1
PIN ? C0
EQUATIONS
O0 = I1*I2
O0.CLKF = CLK
O0.RSTF = I4*I3
O0.SETF = I3*I1*I4
N1 = I3*I1*O0 + I0*I3 + I2*/I1*/I0
XN1 = N1 * I3
CASE (I0,I1)
BEGIN
2: BEGIN C0 = I3*I4 END
3: BEGIN C0 = /I4*/I2*/I3 + /I2*I4 END
1: BEGIN C0 = /I2*/I4 + /I2 + I3*I4 END
OTHERWISE: BEGIN C0 = /I4 + I2 + /I2*I4 END
END
