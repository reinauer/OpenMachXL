CHIP F00020 MACH110
PIN ? CLK
PIN ? I0
PIN ? Q0 REG
PIN ? Q1 REG
STATE
MEALY_MACHINE
DEFAULT_BRANCH HOLD_STATE
CLKF = CLK
S0 = /Q0*/Q1
S1 = Q0*/Q1
S2 = /Q0*Q1
S3 = Q0*Q1
S0 := I0 -> S3
        + /I0 -> S2
        +-> S0
S1 := I0 -> S3
        +-> S1
S2 := /I0 -> S0
S3 := /I0 -> S3
        +-> S1
