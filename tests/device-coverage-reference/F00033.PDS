CHIP F00033 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? O0 REG
PIN ? O1 REG
PIN ? O2 REG
PIN ? O3 REG
EQUATIONS
O0 = /I0*I1 + I1 + /I0
O0.CLKF = CLK
O0.RSTF = I0*/I1
O0.TRST = I1
O1 := O0*/I0*I1 :+: I1*I0*O0
O1.RSTF = I1
O2 = /I0 + O1*I0 + I1*O0
O2.CLKF = CLK
O3 := /O2*I1*I0 + /O1*I0*/I1 + /O2*I1
O3.CLKF = CLK
