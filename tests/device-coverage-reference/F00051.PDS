CHIP F00051 MACH210
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
NODE ? N1 REG
NODE ? N2 REG
PIN ? O3 REG
PIN ? XN2
PIN ? B0
EQUATIONS
O0 := I3*I2 + I5
O0.TRST = I1
N1 = /I2*/I3 + I3*/I4
N1.CLKF = CLK
N1.RSTF = /I3*I1*/I5
N2 = I4*O0*/I5 + N1*I0*I2 + I3*/I5
N2.RSTF = I5
O3 := I4*O0*N2 + /N1*/O0*I1 + /I1*I5*I3
O3.CLKF = CLK
O3.RSTF = /I4*I1*I3
XN2 = N2 * I5
IF (I2*I1*I3) THEN
BEGIN
B0 = I2*I3*I1 + /I4*/I3*I1 + I4*/I5
END
ELSE
BEGIN
B0 = I1*/I2 + I4
END
