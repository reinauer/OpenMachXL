CHIP F00049 MACH130
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? O0 REG
PIN ? O1
NODE ? N2
PIN ? O3 REG
PIN ? XN2
PIN ? C0
EQUATIONS
O0 := /I1*I0*I2 + I2 + I2*/I1
O0.CLKF = CLK
O0.SETF = I2*/I1
O1 = O0*/I0 :+: I0*I2
O1.TRST = I2*/I0*I1
N2 = (O0*I0 + I1*O0) * (/I2 + I0)
O3 = I1*O1 :+: /I0
O3.CLKF = CLK
O3.RSTF = /I1
O3.TRST = I2*I1
XN2 = N2 * I0
CASE (I0,I1)
BEGIN
2: BEGIN C0 = I2 + /I2 + I2 END
1: BEGIN C0 = I2 END
OTHERWISE: BEGIN C0 = I2 + /I2 END
END
