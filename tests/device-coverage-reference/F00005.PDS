CHIP F00005 MACH130
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? Q0 REG
PIN ? Q1 REG
PIN ? Z
STATE
MEALY_MACHINE
DEFAULT_BRANCH S1
CLKF = CLK
S0 = /Q0*/Q1
S1 = Q0*/Q1
S0 := I0 -> S1
S1 := I1 -> S0
        + /I1 -> S1
        +-> S0
S1.OUTF = G2 -> Z
        + G1 -> /Z
        + G0 -> Z
CONDITIONS
G0 = I1*I0
G1 = I1*/I0
G2 = /I1
