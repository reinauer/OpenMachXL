CHIP F00064 MACH110
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? O0 REG
PIN ? O1
PIN ? O2 REG
PIN ? O3 REG
PIN ? O4
EQUATIONS
O0 := /I0*I1 + I0*I1 + I0*/I1
O0.CLKF = CLK
O1 = /O0*/I0*I1 + /I1 + I1
O2 = O0 :+: I1
O2.CLKF = CLK
O3 = /O2
O3.CLKF = CLK
O3.TRST = I0*I1
O4 = (I0*O2*O1 + I1*O2 + O1*O2) * (/I0*I1)
O4.TRST = I1
