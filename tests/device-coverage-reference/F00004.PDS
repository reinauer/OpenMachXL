CHIP F00004 MACH221
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
PIN ? C0
EQUATIONS
O0 := I3
O0.TRST = I0
CASE (I0,I1)
BEGIN
1: BEGIN C0 = I2*/I4*/I3 + I4*/I3*I5 END
0: BEGIN C0 = /I4 + I2*I3*I4 END
3: BEGIN C0 = /I3 + /I3*I4*/I2 + I5 END
OTHERWISE: BEGIN C0 = I4 + /I4*I3 + I3*I2 END
END
