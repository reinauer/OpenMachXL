CHIP F00060 MACH130
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0 REG
NODE ? N1 REG
PIN ? O2 REG
PIN ? O3
PIN ? B0
EQUATIONS
O0 = I1*/I2 :+: I0*I2
O0.CLKF = CLK
O0.RSTF = I0*I1
N1 := /I0*/O0 + /I1
O2 := (I2*/O0 + /I3) * (I3*/N1*/I2 + O0*/I2*I3 + /I0*/N1)
O2.CLKF = CLK
O2.SETF = /I0
O2.TRST = I3*I2*I0
O3 = /O0*I1*/I0 + I2
IF (I2) THEN
BEGIN
B0 = /I3
END
ELSE
BEGIN
B0 = I1*I3 + I1
END
