CHIP F00052 MACH445
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0 REG
PIN ? O1 REG
PIN ? C0
EQUATIONS
O0 := /I2*I3*I0 + /I3 + I3*I2*I1
O0.CLKF = I2*I3
O0.RSTF = /I2*I3
O1 = O0*I0 + I3 + /I2*I1
O1.CLKF = CLK
O1.RSTF = I2
CASE (I0,I1)
BEGIN
3: BEGIN C0 = I3*I2 END
0: BEGIN C0 = /I2 + I2*I3 END
1: BEGIN C0 = I2 END
OTHERWISE: BEGIN C0 = I3*I2 + I2 + I2 END
END
