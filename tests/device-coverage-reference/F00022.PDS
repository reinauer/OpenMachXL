CHIP F00022 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
NODE ? N1 REG
NODE ? N2
PIN ? O3 REG
PIN ? O4 REG
PIN ? XN1
PIN ? XN2
EQUATIONS
O0 := /I0*/I2*/I3 + I5*I4 + I0*/I1*/I2
O0.TRST = I4*/I2
N1 = I3 + I4
N1.RSTF = /I0*/I2
N1.SETF = I4*I0
N2 = (/I2) * (I4*I3*I5)
O3 = N2
O3.CLKF = CLK
O4 = I1 + I0*I4 + I1
