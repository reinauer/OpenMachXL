CHIP F00047 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0 REG
PIN ? O1 REG
NODE ? N2 REG
PIN ? XN2
PIN ? B0
EQUATIONS
O0 := I1
O0.CLKF = CLK
O1 = O0*I0
O1.TRST = I3*I2*I0
N2 = O1*I0
N2.CLKF = CLK
XN2 = N2 * I1
IF (I0*I3*I1) THEN
BEGIN
B0 = /I2*I1 + /I0 + I3*I0
END
ELSE
BEGIN
B0 = I3*/I2 + I1*I2*I0
END
