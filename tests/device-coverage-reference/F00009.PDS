CHIP F00009 MACH110
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? O0 REG
PIN ? O1 REG
PIN ? C0
EQUATIONS
O0 := /I2*I3 + I1*/I3 + I1*I0
O0.CLKF = CLK
O1 = I3*I0*O0 + I0*/I3*/I2
O1.CLKF = CLK
CASE (I0,I1)
BEGIN
0: BEGIN C0 = I2*/I3 + I3*I2 END
2: BEGIN C0 = I2 + I2 + I2*I3 END
1: BEGIN C0 = /I3*I2 + /I3 + I2 END
END
