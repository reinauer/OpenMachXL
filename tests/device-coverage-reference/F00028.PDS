CHIP F00028 MACH220
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? O0
PIN ? O1
NODE ? N2 REG
PIN ? O3
NODE ? N4
PIN ? XN2
PIN ? XN4
PIN ? B0
EQUATIONS
O0 = I2*I4*I0
O1 = I1*O0*I3
N2 := (O0*/I2*I0 + O0 + I0) * (O1*/I1*O0)
N2.CLKF = CLK
N2.RSTF = /I3*I1*/I0
O3 = I2*O1*I1
O3.TRST = I2*I1
N4 = I2*/I4*O1
XN2 = N2 * I2
XN4 = N4 * I3
IF (/I2*/I4) THEN
BEGIN
B0 = /I4*/I1 + I3*/I2*/I0 + /I3*/I0
END
ELSE
BEGIN
B0 = I2*/I4*/I0
END
