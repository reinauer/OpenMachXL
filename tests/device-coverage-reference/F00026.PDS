CHIP F00026 MACH221
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? O0 REG
PIN ? O1
PIN ? B0
EQUATIONS
O0 := /I2*I0 + I5
O0.CLKF = CLK
O0.TRST = /I4*/I0*/I1
O1 = (I5*/I4*I1 + /I3*I1) * (/I0*I5*I2)
O1.TRST = I4
IF (I0*/I4*I1) THEN
BEGIN
B0 = I4*/I5*I0 + I4*I3*I1
END
ELSE
BEGIN
B0 = I4*I5 + I0*I1*I2 + /I4*I0*/I2
END
