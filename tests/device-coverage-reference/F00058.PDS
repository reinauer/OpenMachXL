CHIP F00058 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? O0
PIN ? O1 REG
PIN ? O2
PIN ? B0
EQUATIONS
O0 = I1*/I0*I2 + /I1*I0
O1 := I2 :+: I0*I2*/O0
O1.CLKF = CLK
O1.RSTF = I1
O2 = (I1 + I2*O0*I1) * (O0*/I1 + I2*I1)
IF (/I1) THEN
BEGIN
B0 = I2*/I0 + I0*/I1
END
ELSE
BEGIN
B0 = I2 + /I1*/I2*I0 + /I0
END
