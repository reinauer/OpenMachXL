CHIP F00055 MACH121
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? O0 REG
PIN ? O1
PIN ? O2 REG
PIN ? O3
PIN ? B0
EQUATIONS
O0 = I0 :+: /I0
O0.CLKF = CLK
O0.RSTF = I1
O0.SETF = I1
O0.TRST = I1*I0
O1 = /I0 + I0*/I1*O0
O2 = I1*/I0*/O1 + I0 + /O1
O2.CLKF = CLK
O2.RSTF = /I1*I0
O2.TRST = /I0*I1
O3 = (O2*/I0) * (O2*O0 + /I1*I0*O1 + I0*O1*I1)
O3.TRST = I0
IF (I0*/I1) THEN
BEGIN
B0 = I0 + I0*I1
END
ELSE
BEGIN
B0 = I1*/I0
END
