CHIP F00050 MACH220
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? O0 REG
NODE ? N1
PIN ? O2 LATCHED
PIN ? O3
PIN ? XN1
EQUATIONS
O0 := I4*/I3*/I2
O0.CLKF = CLK
O0.TRST = I2*I0*/I1
N1 = (O0*/I1*I0) * (/I0 + I2)
O2 = /I1*I0
O2.RSTF = /I1*/I4
O3 = (I0*N1) * (I3 + I3*I0*I2)
XN1 = N1 * I1
