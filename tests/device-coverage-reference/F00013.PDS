CHIP F00013 MACH130
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? O0 REG
PIN ? O1 REG
PIN ? O2 REG
PIN ? O3 REG
PIN ? O4 REG
PIN ? B0
EQUATIONS
O0 = I1 + I1*I0
O0.CLKF = CLK
O1 := /I0*/I1 + O0 + I0*O0
O1.CLKF = CLK
O1.RSTF = I0
O2 = I1*I0*/O1 + I1*O0*I0
O2.CLKF = CLK
O3 = O2*/I1
O3.CLKF = CLK
O4 := I0 :+: O2*/O0*O3
O4.CLKF = CLK
IF (I0*/I1) THEN
BEGIN
B0 = I1
END
ELSE
BEGIN
B0 = /I1*/I0 + /I1*/I0
END
