CHIP MATRIX MACH211
PIN 10 A
PIN 32 B
PIN 14 C
PIN 15 D
PIN 16 E
PIN 17 F
PIN 11 CLK
PIN 2 Q0 REG
PIN 3 Q1 REG
PIN 4 Q2 REG
PIN 5 Q3 
EQUATIONS
Q0=/C*F+/A*/D*/F+A*/B*C+A*/B*E*F+A*B*/D*F+B*C*D+/B*/C*/D*/E
Q0.CLKF=CLK
Q1.T=/A*F+/B*D+C*F+/A*/C*/D*F+A*/C+/A*/C+/D*/F
Q1.CLKF=CLK
Q2=(B*C*F+A*B*C*/D+/D*/E+/A*C*E*F+A*/C*/D+/A*/B*C*/D+/E*F) :+: F
Q2.CLKF=CLK
Q3=/A*B*F+/B*C*/F+B*C*/E*/F+/B*/C+A*B+A*C*/E*/F+C*/E*F
