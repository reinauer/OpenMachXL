CHIP SCI5 MACH111
PIN 2 A
PIN 3 B
PIN 11 CLK
PIN 18 Y REG
STATE
MEALY_MACHINE
CLKF=CLK
START_UP.OUTF := POWER_UP -> Y + INIT -> /Y
S0 := A -> S1 +-> S0
S1 := B -> S0 +-> S1
S0.OUTF := A -> Y +-> /Y
S1.OUTF := B -> Y +-> /Y
CONDITIONS
INIT=A*B
SIMULATION
SETF /A /B /CLK
CHECK Y
SETF A B
CHECK /Y
SETF /A /B
CLOCKF CLK
