EQUATIONS
Q0=B*D*/F+A*B*/D*E+/C*D+A*/C*D*/F+/B*/D*/F+A*/B*/C*E+C*/D
Q0.CLKF=CLK
Q1.T=/B*C*E*/F+/A*/B*/C*/F+/A*B+B*D*/E*F+A*/C*/E*/F+A*C*/D*E+/B*/C*/D
Q1.CLKF=CLK
Q2=(/A*C*/D*/F+/B*C*D+/B*/C*E+/D*/E+/B*D*E+A*B*D*/E+/B*/D) :+: F
Q2.CLKF=CLK
Q3=/A*/F+A*E+/B*D*/E*/F+C*D*F+C*E+/D*/E+C*/F
