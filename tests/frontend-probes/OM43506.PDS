CHIP MATRIX MACH435
PIN 3 A
PIN 4 B
PIN 5 C
PIN 6 D
PIN 7 E
PIN 12 F
PIN 20 CLK
PIN 8 Q0 REG
PIN 9 Q1 REG
PIN 10 Q2 REG
PIN 19 Q3 
EQUATIONS
Q0=/A*/D*/E*/F+A*/B*/D*/E+A*B+B*C+A*/C*D+/B*C+/B*E*/F
Q0.CLKF=CLK
Q1.T=A*/C*/D*/E+/A*/F+/C*/F+/B*/D*E+B*D*/E+/A*B*E+/B*/C*/D*E
Q1.CLKF=CLK
Q2=(D*/E+E*/F+B*/E+B*C*/D*/E+/C*D*E+C*D*F+/C*/E) :+: F
Q2.CLKF=CLK
Q3=/B*C*/D*F+/A*/D*/E*/F+B*/F+/B*/C*/E*F+/C*D+A*/B*/D*E+/A*/C*/D*/F
