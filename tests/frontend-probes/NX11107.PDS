CHIP MATRIX MACH111
PIN 10 A
PIN 32 B
PIN 14 C
PIN 15 D
PIN 16 E
PIN 17 F
PIN 11 CLK
PIN 2 Q0 REG
PIN 3 Q1 REG
PIN 4 Q2 REG
PIN 5 Q3 
EQUATIONS
Q0=/A*D*/E*F+/D*E*/F+/A*/B*C*E+D*E+/B*/F+/A*/B*/D*F+/A*C*/D*/F
Q0.CLKF=CLK
Q1.T=A*/C*/D+/A*D*F+/A*C+A*/B*C+B*/F+/A*/C*E+/C*/E*F
Q1.CLKF=CLK
Q2=(C*D*/E*/F+A*D*/F+C*/F+/A*B*D+/A*/B+A*/B*C*F+/E*/F) :+: F
Q2.CLKF=CLK
Q3=/A*B*/D*F+A*/B*/D*/E+/B*/D*/E+A*B*C*E+/C*D*/F+/A*B*/D+/A*E
