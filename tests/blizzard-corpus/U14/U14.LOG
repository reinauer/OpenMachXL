LINE #   |----+----1----+----2----+----3----+----4----+----5----+----6----+
   1     |;PALASM Design Description
   2     |;---------------------------------- Declaration Segment ------------
   3     |TITLE    BLIZZARD 1260 U14 - A1200 BUS CYCLES, BOARD-SPACE CYCLES
   4     |PATTERN  U14
   5     |REVISION 0.1 (RECONSTRUCTION)
   6     |AUTHOR   RECONSTRUCTED FROM THE PCB, SEE ../ARCHITECTURE.MD
   7     |COMPANY  BLIZZARD 1260 KICAD PROJECT
   8     |DATE     2026-10-26
   9     |CHIP     U14 MACH111
  10     |
  11     |; Clock: the A1200 14 MHz CPUCLK comes in on pin 41 and goes out inverted on
  12     |; pin 8 into the clock pin 7. All registers therefore change on the FALLING
  13     |; edge of CPUCLK, which is what the A1200 functional spec asks of a fast
  14     |; card: AS (and DS for reads) on a falling edge, DS for writes one falling
  15     |; edge later, DSACK/BERR sampled on falling edges, AS/DS negated on the next
  16     |; falling edge and the read data latched there.
  17     |;
  18     |; U7 requests a cycle with AREQ (synchronised: AR1, AR2). The type is fixed
  19     |; at the first falling edge after AREQ (FIRST):
  20     |;   IACK: 060 AVEC (the AVEC output is the state), then ADONE; the A1200
  21     |;       is autovector only
  22     |;   TM  A1200 cycle; a 16-bit port answering a long at A1 = 0 gets a second
  23     |;       cycle at A1 = 1 (two NEXT pulses to U9, which adds 2 to A1:A0)
  24     |;   TF  diag EPROM read: bytes a..3 are read one by one (NEXT steps U9),
  25     |;       latched into U10/U11 lanes 1-3, then a last step wraps A1:A0 to 0
  26     |;       so the EPROM itself drives byte 0 on lane 0
  27     |;   TL  other board space: one access with LSTB; reads are replicated from
  28     |;       lane 0 to lanes 1-3 (byte reads at any offset work)
  29     |; U10/U11 control: ADOE (drive A1200 data), LDOE (drive local data), both
  30     |; = local mode; LCK01/LCK23 latch lanes 0/1 and 2/3 (LCK23 is the high-word
  31     |; select level during A1200 writes).
  32     |
  33     |;---------------------------------- PIN Declarations ---------------
  34     |PIN  7   LDOE        REGISTERED      ; U10/U11 I3
  35     |PIN  8   TM1                         ; 060 TM1
  36     |PIN  9   TM0                         ; 060 TM0
  37     |PIN  10  TT1                         ; 060 TT1
  38     |PIN  11  TT0                         ; 060 TT0
  39     |PIN  13  CLKIN                       ; inverted CPUCLK from pin 8
  40     |PIN  14  CLKN        COMBINATORIAL   ; /CPUCLK
  41     |PIN  15  RST_N                       ; A1200 _RST
  42     |PIN  16  RSTOUT_N    COMBINATORIAL   ; to U8/J3: 060 RSTO
  43     |PIN  17  BERR_N                      ; A1200 _BERR
  44     |PIN  18  NEXT_N      REGISTERED      ; to U9: advance A1:A0
  45     |PIN  19  A31                         ; 060 A31, unused here
  46     |PIN  20  LCK01       REGISTERED      ; U10/U11 CLK0
  47     |PIN  21  LONG_N                      ; from U9
  48     |PIN  24  FC1         COMBINATORIAL   ; A1200 FC1
  49     |PIN  25  ADONE_N     REGISTERED      ; to U7
  50     |PIN  26  LSTB_N      REGISTERED      ; to U1/J3: board-space strobe
  51     |PIN  27  DS_N        REGISTERED      ; A1200 _DS
  52     |PIN  28  DISABLE_N                   ; from U1
  53     |PIN  29  R_W                         ; 060 R/W (= A1200 R/W)
  54     |PIN  30  FC2         COMBINATORIAL   ; A1200 FC2 (slot pin 103)
  55     |PIN  31  AVEC_N      REGISTERED      ; 060 /AVEC
  56     |PIN  32  AREQ_N                      ; from U7
  57     |PIN  33  KACK_N                      ; J3.87, unused here (fixed timing)
  58     |PIN  35  RSTO_N                      ; 060 /RSTO
  59     |PIN  36  BOSS_N                      ; A1200 _BR/_BOSS, unused here
  60     |PIN  37  FC0         COMBINATORIAL   ; A1200 FC0
  61     |PIN  38  AA1                         ; A1200 A1 (from U9)
  62     |PIN  39  AA0                         ; A1200 A0 (from U9)
  63     |PIN  40  AS_N        REGISTERED      ; A1200 _AS
  64     |PIN  41  DSACK1_N                    ; A1200 _DSACK1
  65     |PIN  42  DSACK0_N                    ; A1200 _DSACK0
  66     |PIN  43  AMIGA_N                     ; from U1
  67     |PIN  2   LCK23       REGISTERED      ; U10/U11 CLK2
  68     |PIN  3   CPUCLK                      ; A1200 CPUCLK_A (slot pin 99)
  69     |PIN  4   ADOE        REGISTERED      ; U10/U11 I0
  70     |PIN  5   F0SEL_N                     ; from U1
  71     |PIN  6   TM2                         ; 060 TM2
  72     |
  73     |NODE ?   AR1         REGISTERED      ; AREQ synchroniser
  74     |NODE ?   AR2         REGISTERED
  75     |NODE ?   TM          REGISTERED      ; cycle types (TI is the AVEC output)
  76     |NODE ?   TF          REGISTERED
  77     |NODE ?   TL          REGISTERED
  78     |NODE ?   SS          REGISTERED      ; start an A1200 sub-cycle
  79     |NODE ?   ACK         REGISTERED      ; DSACK/BERR seen
  80     |NODE ?   P16         REGISTERED      ; ... from a 16-bit port
  81     |NODE ?   DN1         REGISTERED      ; A1200 cycle finished
  82     |NODE ?   NS2         REGISTERED      ; second-half sequence
  83     |NODE ?   NS3         REGISTERED
  84     |NODE ?   NS4         REGISTERED
  85     |NODE ?   W1          REGISTERED      ; board-space step counter
  86     |NODE ?   W0          REGISTERED
  87     |NODE ?   FIN         REGISTERED      ; EPROM: wrapped back to offset 0; board space: latch now
  88     |
  89     |;---------------------------------- Boolean Equation Segment ------
  90     |STRING  FIRST    '(AR2 * AVEC_N * /TM * /TF * /TL)'   ; request seen, type not yet set
  91     |STRING  W2       '(W1 * /W0)'
  92     |STRING  MORE     '(P16 * /LONG_N * /AA1)'
  93     |
  94     |EQUATIONS
  95     |
  96     |CLKN        = /CPUCLK
  97     |RSTOUT_N    = RSTO_N
  98     |
  99     |; ---- function codes from TT/TM (A1200 sees a 68020) -------------------------
 100     |; TT 11 acknowledge -> 7; TT 10 alternate -> TM; TT 0x: user data 1, user
 101     |; code 2, supervisor data 5, supervisor code 6, push/table search -> 5/6
 102     |FC2         = TT1 * TT0 + TT1 * TM2 + /TT1 * TM2 + /TT1 * /TM1 * /TM0 + /TT1 * TM1 * TM0
 103     |FC2.TRST    = DISABLE_N
 104     |FC1         = TT1 * TT0 + TT1 * TM1 + /TT1 * TM1 * /TM0 + /TT1 * TM2 * /TM0
 105     |FC1.TRST    = DISABLE_N
 106     |FC0         = TT1 * TT0 + TT1 * TM0 + /TT1 * TM0 + /TT1 * /TM2 * /TM1
 107     |FC0.TRST    = DISABLE_N
 108     |
 109     |; ---- request and cycle type ---------------------------------------------------
 110     |AR1        := RST_N * /AREQ_N
 111     |AR1.CLKF    = CLKIN
 112     |AR2        := RST_N * AR1
 113     |AR2.CLKF    = CLKIN
 114     |
 115     |; The IACK address ($FFFFFFFF) is never A1200 or EPROM space, so TM/TF exclude
 116     |; it by decode; TL may run alongside an IACK, harmlessly (the 060 ignores the
 117     |; data bus when AVEC is asserted).
 118     |TM         :=  
 118  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 118     |                     * /AMIGA_N
 119     |            + TM * AR2
 120     |TM.CLKF     = CLKIN
 121     |TF         :=  
 121  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 121     |                     * AMIGA_N * /F0SEL_N * R_W
 122     |            + TF * AR2
 123     |TF.CLKF     = CLKIN
 124     |TL         :=  
 124  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 124     |                     * AMIGA_N * F0SEL_N
 125     |            +  
 125  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 125     |                     * AMIGA_N * /R_W
 126     |            + TL * AR2
 127     |TL.CLKF     = CLKIN
 128     |
 129     |; ---- interrupt acknowledge --------------------------------------------------------
 130     |/AVEC_N    :=  
 130  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 130     |                     * TT1 * TT0 * TM2
 131     |            +  
 131  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 131     |                     * TT1 * TT0 * TM1
 132     |            +  
 132  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 132     |                     * TT1 * TT0 * TM0
 133     |            + /AVEC_N * AR2
 134     |AVEC_N.CLKF = CLKIN
 135     |
 136     |; ---- A1200 cycle ------------------------------------------------------------------
 137     |SS         :=  
 137  s1 |(AR2 * AVEC_N * /TM * /TF * /TL)
 137     |                     * /AMIGA_N
 138     |            + NS4
 139     |SS.CLKF     = CLKIN
 140     |; BERR ends AS/DS but never ADONE: U7's watchdog then gives the 060 TEA
 141     |/AS_N      := RST_N * SS
 142     |            + RST_N * /AS_N * /ACK * BERR_N
 143     |AS_N.CLKF   = CLKIN
 144     |AS_N.TRST   = DISABLE_N
 145     |/DS_N      := RST_N * SS * R_W
 146     |            + RST_N * /AS_N * DS_N * /R_W * /ACK * BERR_N
 147     |            + RST_N * /DS_N * /ACK * BERR_N
 148     |DS_N.CLKF   = CLKIN
 149     |DS_N.TRST   = DISABLE_N
 150     |ACK        := /AS_N * /ACK * /DSACK1_N
 151     |            + /AS_N * /ACK * /DSACK0_N
 152     |ACK.CLKF    = CLKIN
 153     |P16        := /AS_N * /ACK * /DSACK1_N * DSACK0_N
 154     |            + P16 * ACK
 155     |P16.CLKF    = CLKIN
 156     |DN1        := TM * ACK * /P16
 157     |            + TM * ACK * LONG_N
 158     |            + TM * ACK * AA1
 159     |DN1.CLKF    = CLKIN
 160     |NS2        := TM * ACK *  
 160  s1 |(P16 * /LONG_N * /AA1)
 160     |
 161     |NS2.CLKF    = CLKIN
 162     |NS3        := NS2
 163     |NS3.CLKF    = CLKIN
 164     |NS4        := NS3
 165     |NS4.CLKF    = CLKIN
 166     |
 167     |; ---- board-space step counter ------------------------------------------------------
 168     |W0         := TF * AR2 * /W0
 169     |            + TL * AR2 * /W0
 170     |W0.CLKF     = CLKIN
 171     |W1         := TF * AR2 * (W1 :+: W0)
 172     |            + TL * AR2 * (W1 :+: W0)
 173     |W1.CLKF     = CLKIN
 174     |FIN        := TF *  
 174  s1 |(W1 * /W0)
 174     |                       * AA1 * AA0
 175     |            + TL * /W1 * W0
 176     |            + FIN * TF
 177     |            + FIN * TL
 178     |FIN.CLKF    = CLKIN
 179     |
 180     |; Board space (TL): strobe while W = 0/1 (first round only, FIN), latch
 181     |; lanes at W = 2 and again at W = 0 of the next round (FIN set), ADONE with
 182     |; the second latch. The first latch is one edge after LDOE turns on, so
 183     |; U10/U11 are already in local mode when they latch.
 184     |/LSTB_N    := TL * AR2 * /W1 * /FIN
 185     |LSTB_N.CLKF = CLKIN
 186     |
 187     |; ---- U9 offset steps ------------------------------------------------------------------
 188     |/NEXT_N    := TM * ACK *  
 188  s1 |(P16 * /LONG_N * /AA1)
 188     |
 189     |            + NS3
 190     |            + TF *  
 190  s1 |(W1 * /W0)
 190     |                       * /FIN
 191     |NEXT_N.CLKF = CLKIN
 192     |
 193     |; ---- U10/U11 data path -----------------------------------------------------------------
 194     |ADOE       := AR2 * TF
 195     |            + AR2 * TL * R_W
 196     |            + AR2 * TM * /R_W
 197     |ADOE.CLKF   = CLKIN
 198     |; off as soon as U7 drops AREQ, so the next cycle finds the local bus free
 199     |LDOE       := AR2 * ADOE * R_W * /AREQ_N
 200     |            + TM * R_W * /AS_N * /ACK * /DSACK1_N * DSACK0_N * AA1 * /AREQ_N
 201     |            + TM * R_W * DN1 * /AREQ_N
 202     |            + LDOE * AR2 * TM * R_W * /AREQ_N
 203     |LDOE.CLKF   = CLKIN
 204     |LCK01      := TM * R_W * ACK * /P16
 205     |            + TM * R_W * ACK * /AA1
 206     |            + TF *  
 206  s1 |(W1 * /W0)
 206     |                       * /FIN * /AA1
 207     |            + TL * /W0 * FIN
 208     |LCK01.CLKF  = CLKIN
 209     |LCK23      := TM * R_W * ACK
 210     |            + TM * /R_W * AA1
 211     |            + TF *  
 211  s1 |(W1 * /W0)
 211     |                       * /FIN * AA1
 212     |            + TL * /W0 * FIN
 213     |LCK23.CLKF  = CLKIN
 214     |
 215     |; ---- done --------------------------------------------------------------------------------
 216     |/ADONE_N   := /AVEC_N
 217     |            + DN1
 218     |            + TF *  
 218  s1 |(W1 * /W0)
 218     |                       * FIN
 219     |            + TL * /W1 * /W0 * FIN
 220     |            + /ADONE_N * AR2
 221     |ADONE_N.CLKF = CLKIN

