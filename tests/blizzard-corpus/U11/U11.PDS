;PALASM Design Description
;---------------------------------- Declaration Segment ------------
TITLE    BLIZZARD 1260 U11 - DATA PATH LOCAL BUS <-> A1200, EVEN BITS
PATTERN  U11
REVISION 0.1 (RECONSTRUCTION)
AUTHOR   GENERATED BY TOOLS/GEN_DATAPATH.PY, SEE ../ARCHITECTURE.MD
COMPANY  BLIZZARD 1260 KICAD PROJECT
DATE     2026-10-26
CHIP     U11 MACH111

; One registered output per local-bus pin and one combinatorial output per
; A1200 data pin. Names: Ln = local-bus pin of 060 data bit n (SIMM-Dx on
; the board, see pins.md), Dn = A1200 data bit n. Byte lanes: lane 0 =
; bits 31-24, lane 3 = bits 7-0.
;
; Controls from U14:
;   ADOE  (I0)    drive the A1200 bus (writes)
;   LDOE  (I3)    drive the local bus (reads)
;   ADOE * LDOE   local mode: lane 0 is an input (EPROM / expansion drives
;                 it), lanes 1-3 are driven from the registers
;   LCK01 (CLK0)  latch lanes 0/1: A1200 lanes 0/1, or lane 0 into lane 1
;                 in local mode
;   LCK23 (CLK2)  latch lanes 2/3: A1200 lanes 2/3, A1200 lanes 0/1 when
;                 LDOE is already on (16-bit port, upper word), or in
;                 local mode lane 0 -> lane 3 and lane 3 -> lane 2.
;                 During writes its level selects the upper word: A1200
;                 lanes 0/1 then carry local lanes 2/3 (68020 replication).

;---------------------------------- PIN Declarations ---------------
PIN  7   D22         COMBINATORIAL   ; A1200 D22 (lane 1)
PIN  8   D26         COMBINATORIAL   ; A1200 D26 (lane 0)
PIN  9   D30         COMBINATORIAL   ; A1200 D30 (lane 0)
PIN  10  ADOE                        ; from U14
PIN  11  LCK01                       ; from U14
PIN  14  L2          REGISTERED      ; local bus SIMM-D26 (lane 3)
PIN  15  L6          REGISTERED      ; local bus SIMM-D29 (lane 3)
PIN  16  L10         REGISTERED      ; local bus SIMM-D13 (lane 2)
PIN  17  L14         REGISTERED      ; local bus SIMM-D15 (lane 2)
PIN  18  L18         REGISTERED      ; local bus SIMM-D21 (lane 1)
PIN  19  L22         REGISTERED      ; local bus SIMM-D17 (lane 1)
PIN  20  L26         REGISTERED      ; local bus SIMM-D2 (lane 0)
PIN  21  L30         REGISTERED      ; local bus SIMM-D6 (lane 0)
PIN  24  D0          COMBINATORIAL   ; A1200 D0 (lane 3)
PIN  25  D4          COMBINATORIAL   ; A1200 D4 (lane 3)
PIN  26  D8          COMBINATORIAL   ; A1200 D8 (lane 2)
PIN  27  D12         COMBINATORIAL   ; A1200 D12 (lane 2)
PIN  28  D16         COMBINATORIAL   ; A1200 D16 (lane 1)
PIN  29  D20         COMBINATORIAL   ; A1200 D20 (lane 1)
PIN  30  D24         COMBINATORIAL   ; A1200 D24 (lane 0)
PIN  31  D28         COMBINATORIAL   ; A1200 D28 (lane 0)
PIN  32  LDOE                        ; from U14
PIN  33  LCK23                       ; from U14
PIN  36  L0          REGISTERED      ; local bus SIMM-D25 (lane 3)
PIN  37  L4          REGISTERED      ; local bus SIMM-D28 (lane 3)
PIN  38  L8          REGISTERED      ; local bus SIMM-D8 (lane 2)
PIN  39  L12         REGISTERED      ; local bus SIMM-D14 (lane 2)
PIN  40  L16         REGISTERED      ; local bus SIMM-D23 (lane 1)
PIN  41  L20         REGISTERED      ; local bus SIMM-D19 (lane 1)
PIN  42  L24         REGISTERED      ; local bus SIMM-D0 (lane 0)
PIN  43  L28         REGISTERED      ; local bus SIMM-D4 (lane 0)
PIN  2   D2          COMBINATORIAL   ; A1200 D2 (lane 3)
PIN  3   D6          COMBINATORIAL   ; A1200 D6 (lane 3)
PIN  4   D10         COMBINATORIAL   ; A1200 D10 (lane 2)
PIN  5   D14         COMBINATORIAL   ; A1200 D14 (lane 2)
PIN  6   D18         COMBINATORIAL   ; A1200 D18 (lane 1)

;---------------------------------- Boolean Equation Segment ------
EQUATIONS

; ---- bit 0 (lane 3)
L0   := ADOE * LDOE * L24
       + /ADOE * LDOE * D16 + /LDOE * D0
L0.CLKF = LCK23
L0.TRST = LDOE
D0   = L0
D0.TRST = ADOE * /LDOE

; ---- bit 2 (lane 3)
L2   := ADOE * LDOE * L26
       + /ADOE * LDOE * D18 + /LDOE * D2
L2.CLKF = LCK23
L2.TRST = LDOE
D2   = L2
D2.TRST = ADOE * /LDOE

; ---- bit 4 (lane 3)
L4   := ADOE * LDOE * L28
       + /ADOE * LDOE * D20 + /LDOE * D4
L4.CLKF = LCK23
L4.TRST = LDOE
D4   = L4
D4.TRST = ADOE * /LDOE

; ---- bit 6 (lane 3)
L6   := ADOE * LDOE * L30
       + /ADOE * LDOE * D22 + /LDOE * D6
L6.CLKF = LCK23
L6.TRST = LDOE
D6   = L6
D6.TRST = ADOE * /LDOE

; ---- bit 8 (lane 2)
L8   := ADOE * LDOE * L0
       + /ADOE * LDOE * D24 + /LDOE * D8
L8.CLKF = LCK23
L8.TRST = LDOE
D8   = L8
D8.TRST = ADOE * /LDOE

; ---- bit 10 (lane 2)
L10   := ADOE * LDOE * L2
       + /ADOE * LDOE * D26 + /LDOE * D10
L10.CLKF = LCK23
L10.TRST = LDOE
D10   = L10
D10.TRST = ADOE * /LDOE

; ---- bit 12 (lane 2)
L12   := ADOE * LDOE * L4
       + /ADOE * LDOE * D28 + /LDOE * D12
L12.CLKF = LCK23
L12.TRST = LDOE
D12   = L12
D12.TRST = ADOE * /LDOE

; ---- bit 14 (lane 2)
L14   := ADOE * LDOE * L6
       + /ADOE * LDOE * D30 + /LDOE * D14
L14.CLKF = LCK23
L14.TRST = LDOE
D14   = L14
D14.TRST = ADOE * /LDOE

; ---- bit 16 (lane 1)
L16   := ADOE * LDOE * L24
       + /ADOE * D16 + /LDOE * D16
L16.CLKF = LCK01
L16.TRST = LDOE
D16   = /LCK23 * L16 + LCK23 * L0
D16.TRST = ADOE * /LDOE

; ---- bit 18 (lane 1)
L18   := ADOE * LDOE * L26
       + /ADOE * D18 + /LDOE * D18
L18.CLKF = LCK01
L18.TRST = LDOE
D18   = /LCK23 * L18 + LCK23 * L2
D18.TRST = ADOE * /LDOE

; ---- bit 20 (lane 1)
L20   := ADOE * LDOE * L28
       + /ADOE * D20 + /LDOE * D20
L20.CLKF = LCK01
L20.TRST = LDOE
D20   = /LCK23 * L20 + LCK23 * L4
D20.TRST = ADOE * /LDOE

; ---- bit 22 (lane 1)
L22   := ADOE * LDOE * L30
       + /ADOE * D22 + /LDOE * D22
L22.CLKF = LCK01
L22.TRST = LDOE
D22   = /LCK23 * L22 + LCK23 * L6
D22.TRST = ADOE * /LDOE

; ---- bit 24 (lane 0)
L24   := D24
L24.CLKF = LCK01
L24.TRST = /ADOE * LDOE
D24   = /LCK23 * L24 + LCK23 * L8
D24.TRST = ADOE * /LDOE

; ---- bit 26 (lane 0)
L26   := D26
L26.CLKF = LCK01
L26.TRST = /ADOE * LDOE
D26   = /LCK23 * L26 + LCK23 * L10
D26.TRST = ADOE * /LDOE

; ---- bit 28 (lane 0)
L28   := D28
L28.CLKF = LCK01
L28.TRST = /ADOE * LDOE
D28   = /LCK23 * L28 + LCK23 * L12
D28.TRST = ADOE * /LDOE

; ---- bit 30 (lane 0)
L30   := D30
L30.CLKF = LCK01
L30.TRST = /ADOE * LDOE
D30   = /LCK23 * L30 + LCK23 * L14
D30.TRST = ADOE * /LDOE
