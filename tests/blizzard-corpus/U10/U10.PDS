;PALASM Design Description
;---------------------------------- Declaration Segment ------------
TITLE    BLIZZARD 1260 U10 - DATA PATH LOCAL BUS <-> A1200, ODD BITS
PATTERN  U10
REVISION 0.1 (RECONSTRUCTION)
AUTHOR   GENERATED BY TOOLS/GEN_DATAPATH.PY, SEE ../ARCHITECTURE.MD
COMPANY  BLIZZARD 1260 KICAD PROJECT
DATE     2026-10-26
CHIP     U10 MACH111

; One registered output per local-bus pin and one combinatorial output per
; A1200 data pin. Names: Ln = local-bus pin of 060 data bit n (SIMM-Dx on
; the board, see pins.md), Dn = A1200 data bit n. Byte lanes: lane 0 =
; bits 31-24, lane 3 = bits 7-0.
;
; Controls from U14:
;   ADOE  (I0)    drive the A1200 bus (writes)
;   LDOE  (I3)    drive the local bus (reads)
;   ADOE * LDOE   local mode: lane 0 is an input (EPROM / expansion drives
;                 it), lanes 1-3 are driven from the registers
;   LCK01 (CLK0)  latch lanes 0/1: A1200 lanes 0/1, or lane 0 into lane 1
;                 in local mode
;   LCK23 (CLK2)  latch lanes 2/3: A1200 lanes 2/3, A1200 lanes 0/1 when
;                 LDOE is already on (16-bit port, upper word), or in
;                 local mode lane 0 -> lane 3 and lane 3 -> lane 2.
;                 During writes its level selects the upper word: A1200
;                 lanes 0/1 then carry local lanes 2/3 (68020 replication).

;---------------------------------- PIN Declarations ---------------
PIN  7   D23         COMBINATORIAL   ; A1200 D23 (lane 1)
PIN  8   D27         COMBINATORIAL   ; A1200 D27 (lane 0)
PIN  9   D31         COMBINATORIAL   ; A1200 D31 (lane 0)
PIN  10  ADOE                        ; from U14
PIN  11  LCK01                       ; from U14
PIN  14  L3          REGISTERED      ; local bus SIMM-D24 (lane 3)
PIN  15  L7          REGISTERED      ; local bus SIMM-D30 (lane 3)
PIN  16  L11         REGISTERED      ; local bus SIMM-D9 (lane 2)
PIN  17  L15         REGISTERED      ; local bus SIMM-D12 (lane 2)
PIN  18  L19         REGISTERED      ; local bus SIMM-D20 (lane 1)
PIN  19  L23         REGISTERED      ; local bus SIMM-D16 (lane 1)
PIN  20  L27         REGISTERED      ; local bus SIMM-D3 (lane 0)
PIN  21  L31         REGISTERED      ; local bus SIMM-D7 (lane 0)
PIN  24  D1          COMBINATORIAL   ; A1200 D1 (lane 3)
PIN  25  D5          COMBINATORIAL   ; A1200 D5 (lane 3)
PIN  26  D9          COMBINATORIAL   ; A1200 D9 (lane 2)
PIN  27  D13         COMBINATORIAL   ; A1200 D13 (lane 2)
PIN  28  D17         COMBINATORIAL   ; A1200 D17 (lane 1)
PIN  29  D21         COMBINATORIAL   ; A1200 D21 (lane 1)
PIN  30  D25         COMBINATORIAL   ; A1200 D25 (lane 0)
PIN  31  D29         COMBINATORIAL   ; A1200 D29 (lane 0)
PIN  32  LDOE                        ; from U14
PIN  33  LCK23                       ; from U14
PIN  36  L1          REGISTERED      ; local bus SIMM-D27 (lane 3)
PIN  37  L5          REGISTERED      ; local bus SIMM-D31 (lane 3)
PIN  38  L9          REGISTERED      ; local bus SIMM-D10 (lane 2)
PIN  39  L13         REGISTERED      ; local bus SIMM-D11 (lane 2)
PIN  40  L17         REGISTERED      ; local bus SIMM-D22 (lane 1)
PIN  41  L21         REGISTERED      ; local bus SIMM-D18 (lane 1)
PIN  42  L25         REGISTERED      ; local bus SIMM-D1 (lane 0)
PIN  43  L29         REGISTERED      ; local bus SIMM-D5 (lane 0)
PIN  2   D3          COMBINATORIAL   ; A1200 D3 (lane 3)
PIN  3   D7          COMBINATORIAL   ; A1200 D7 (lane 3)
PIN  4   D11         COMBINATORIAL   ; A1200 D11 (lane 2)
PIN  5   D15         COMBINATORIAL   ; A1200 D15 (lane 2)
PIN  6   D19         COMBINATORIAL   ; A1200 D19 (lane 1)

;---------------------------------- Boolean Equation Segment ------
EQUATIONS

; ---- bit 1 (lane 3)
L1   := ADOE * LDOE * L25
       + /ADOE * LDOE * D17 + /LDOE * D1
L1.CLKF = LCK23
L1.TRST = LDOE
D1   = L1
D1.TRST = ADOE * /LDOE

; ---- bit 3 (lane 3)
L3   := ADOE * LDOE * L27
       + /ADOE * LDOE * D19 + /LDOE * D3
L3.CLKF = LCK23
L3.TRST = LDOE
D3   = L3
D3.TRST = ADOE * /LDOE

; ---- bit 5 (lane 3)
L5   := ADOE * LDOE * L29
       + /ADOE * LDOE * D21 + /LDOE * D5
L5.CLKF = LCK23
L5.TRST = LDOE
D5   = L5
D5.TRST = ADOE * /LDOE

; ---- bit 7 (lane 3)
L7   := ADOE * LDOE * L31
       + /ADOE * LDOE * D23 + /LDOE * D7
L7.CLKF = LCK23
L7.TRST = LDOE
D7   = L7
D7.TRST = ADOE * /LDOE

; ---- bit 9 (lane 2)
L9   := ADOE * LDOE * L1
       + /ADOE * LDOE * D25 + /LDOE * D9
L9.CLKF = LCK23
L9.TRST = LDOE
D9   = L9
D9.TRST = ADOE * /LDOE

; ---- bit 11 (lane 2)
L11   := ADOE * LDOE * L3
       + /ADOE * LDOE * D27 + /LDOE * D11
L11.CLKF = LCK23
L11.TRST = LDOE
D11   = L11
D11.TRST = ADOE * /LDOE

; ---- bit 13 (lane 2)
L13   := ADOE * LDOE * L5
       + /ADOE * LDOE * D29 + /LDOE * D13
L13.CLKF = LCK23
L13.TRST = LDOE
D13   = L13
D13.TRST = ADOE * /LDOE

; ---- bit 15 (lane 2)
L15   := ADOE * LDOE * L7
       + /ADOE * LDOE * D31 + /LDOE * D15
L15.CLKF = LCK23
L15.TRST = LDOE
D15   = L15
D15.TRST = ADOE * /LDOE

; ---- bit 17 (lane 1)
L17   := ADOE * LDOE * L25
       + /ADOE * D17 + /LDOE * D17
L17.CLKF = LCK01
L17.TRST = LDOE
D17   = /LCK23 * L17 + LCK23 * L1
D17.TRST = ADOE * /LDOE

; ---- bit 19 (lane 1)
L19   := ADOE * LDOE * L27
       + /ADOE * D19 + /LDOE * D19
L19.CLKF = LCK01
L19.TRST = LDOE
D19   = /LCK23 * L19 + LCK23 * L3
D19.TRST = ADOE * /LDOE

; ---- bit 21 (lane 1)
L21   := ADOE * LDOE * L29
       + /ADOE * D21 + /LDOE * D21
L21.CLKF = LCK01
L21.TRST = LDOE
D21   = /LCK23 * L21 + LCK23 * L5
D21.TRST = ADOE * /LDOE

; ---- bit 23 (lane 1)
L23   := ADOE * LDOE * L31
       + /ADOE * D23 + /LDOE * D23
L23.CLKF = LCK01
L23.TRST = LDOE
D23   = /LCK23 * L23 + LCK23 * L7
D23.TRST = ADOE * /LDOE

; ---- bit 25 (lane 0)
L25   := D25
L25.CLKF = LCK01
L25.TRST = /ADOE * LDOE
D25   = /LCK23 * L25 + LCK23 * L9
D25.TRST = ADOE * /LDOE

; ---- bit 27 (lane 0)
L27   := D27
L27.CLKF = LCK01
L27.TRST = /ADOE * LDOE
D27   = /LCK23 * L27 + LCK23 * L11
D27.TRST = ADOE * /LDOE

; ---- bit 29 (lane 0)
L29   := D29
L29.CLKF = LCK01
L29.TRST = /ADOE * LDOE
D29   = /LCK23 * L29 + LCK23 * L13
D29.TRST = ADOE * /LDOE

; ---- bit 31 (lane 0)
L31   := D31
L31.CLKF = LCK01
L31.TRST = /ADOE * LDOE
D31   = /LCK23 * L31 + LCK23 * L15
D31.TRST = ADOE * /LDOE
