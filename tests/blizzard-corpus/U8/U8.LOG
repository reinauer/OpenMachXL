LINE #   |----+----1----+----2----+----3----+----4----+----5----+----6----+
   1     |;PALASM Design Description
   2     |;---------------------------------- Declaration Segment ------------
   3     |TITLE    BLIZZARD 1260 U8 - RESET, INTERRUPTS, ARBITRATION, REFRESH TIMER
   4     |PATTERN  U8
   5     |REVISION 0.1 (RECONSTRUCTION)
   6     |AUTHOR   RECONSTRUCTED FROM THE PCB, SEE ../ARCHITECTURE.MD
   7     |COMPANY  BLIZZARD 1260 KICAD PROJECT
   8     |DATE     2026-10-26
   9     |CHIP     U8  MACH111
  10     |
  11     |; - A1200 _RST in (pin 26) and out (pin 19): the 060's RESET instruction
  12     |;   (RSTO, relayed by U14 as RSTOUT_N) resets the A1200 through pin 19,
  13     |;   and the self-reset latch SELF keeps that reset from also resetting the
  14     |;   060 via RSTI. An A1200 reset (power-on, Ctrl-Amiga-Amiga) does.
  15     |; - Board disabled (U1): 060 held in reset, _BOSS/_BR released so the
  16     |;   68EC020 runs, no grant for the expansion.
  17     |; - IPL from Paula: double-synchronised, a new level is passed on only
  18     |;   after two equal samples; all negated while RSTI is asserted, so the 060
  19     |;   samples no special modes at reset (68040-style termination).
  20     |; - Expansion bus request/grant: the 060 loses BG, the expansion gets EXTBG
  21     |;   once BB is free and no cycle runs.
  22     |; - DRAM refresh request: one BCLK pulse every 8 E clocks (~11.3 us).
  23     |; - EPROM /OE and the SIMM address bits MA2 (A15/A6) and MA6 (A16/A7).
  24     |
  25     |;---------------------------------- PIN Declarations ---------------
  26     |PIN  7   RSTOUT_N                    ; from U14: 060 RSTO
  27     |PIN  8   BOSS_N      COMBINATORIAL   ; A1200 _BR + _BOSS (open drain)
  28     |PIN  9   A16
  29     |PIN  10  A3                          ; unused here
  30     |PIN  11  A1                          ; unused here
  31     |PIN  13  A4                          ; unused here
  32     |PIN  14  ROMOE_N     COMBINATORIAL   ; EPROM /OE
  33     |PIN  15  A5                          ; unused here
  34     |PIN  16  A15
  35     |PIN  17  MA6         COMBINATORIAL   ; SIMM A6 via RN4
  36     |PIN  18  Z2SEL_N                     ; from U1
  37     |PIN  19  R_W
  38     |PIN  20  IPL2O_N     REGISTERED      ; 060 /IPL2
  39     |PIN  21  EXTBG_N     REGISTERED      ; J3.90: expansion bus grant
  40     |PIN  25  RSTDRV      COMBINATORIAL   ; A1200 _RST, driven low on RSTOUT
  41     |PIN  26  F0SEL2_N                    ; from U1
  42     |PIN  27  BG_N        REGISTERED      ; 060 /BG
  43     |PIN  28  MUX                         ; from U7
  44     |PIN  29  A6
  45     |PIN  30  MA2         COMBINATORIAL   ; SIMM A2 via RN4
  46     |PIN  31  RSTI_N      REGISTERED      ; 060 /RSTI (also to U7/U9)
  47     |PIN  32  RST_N                       ; A1200 _RST
  48     |PIN  33  BCLK                        ; board clock
  49     |PIN  35  ECLK                        ; A1200 E clock (used as data)
  50     |PIN  36  KACK_N                      ; J3.87, unused here
  51     |PIN  37  REFREQ_N    REGISTERED      ; to U7
  52     |PIN  38  TAX_N                       ; from U7, unused here
  53     |PIN  39  CYC_N                       ; from U7
  54     |PIN  40  IPL2_N                      ; A1200 _IPL2
  55     |PIN  41  IPL1_N                      ; A1200 _IPL1
  56     |PIN  42  IPL0_N                      ; A1200 _IPL0
  57     |PIN  43  EXTBR_N                     ; J3.89: expansion bus request (pull-up)
  58     |PIN  2   IPL1O_N     REGISTERED      ; 060 /IPL1
  59     |PIN  3   BB_N                        ; 060 /BB (pull-up)
  60     |PIN  4   DISABLE_N                   ; from U1
  61     |PIN  5   IPL0O_N     REGISTERED      ; 060 /IPL0
  62     |PIN  6   A7
  63     |
  64     |NODE ?   SELF        REGISTERED      ; A1200 reset caused by our RESET instruction
  65     |NODE ?   P2A         REGISTERED      ; IPL synchronisers
  66     |NODE ?   P2B         REGISTERED
  67     |NODE ?   P1A         REGISTERED
  68     |NODE ?   P1B         REGISTERED
  69     |NODE ?   P0A         REGISTERED
  70     |NODE ?   P0B         REGISTERED
  71     |NODE ?   E1          REGISTERED      ; E clock synchroniser
  72     |NODE ?   E2          REGISTERED
  73     |NODE ?   EC2         REGISTERED      ; E clock divider
  74     |NODE ?   EC1         REGISTERED
  75     |NODE ?   EC0         REGISTERED
  76     |NODE ?   KR          REGISTERED      ; expansion request, synchronised
  77     |
  78     |;---------------------------------- Boolean Equation Segment ------
  79     |STRING  ERISE    '(E1 * /E2)'
  80     |
  81     |EQUATIONS
  82     |
  83     |; ---- SIMM address bits -----------------------------------------------------
  84     |MA2        = /MUX * A15 + MUX * A6
  85     |MA6        = /MUX * A16 + MUX * A7
  86     |
  87     |; ---- EPROM: diag window, and the lower 32 K of the Z2 board space ---------
  88     |; only inside a cycle (MUX is high from E3 to the end of every cycle), so the
  89     |; EPROM never drives lane 0 on a stray address between cycles
  90     |/ROMOE_N   = R_W * /F0SEL2_N * MUX
  91     |           + R_W * /Z2SEL_N * /A16 * /A15 * MUX
  92     |
  93     |; ---- reset -----------------------------------------------------------------
  94     |RSTDRV      = GND
  95     |RSTDRV.TRST = /RSTOUT_N
  96     |
  97     |SELF       := /RSTOUT_N
  98     |            + SELF * /RST_N
  99     |SELF.CLKF   = BCLK
 100     |
 101     |/RSTI_N    := /RST_N * /SELF * RSTOUT_N
 102     |            + /DISABLE_N
 103     |RSTI_N.CLKF = BCLK
 104     |
 105     |; ---- A1200 bus ownership: hold _BR/_BOSS low unless disabled -------------------
 106     |BOSS_N      = GND
 107     |BOSS_N.TRST = DISABLE_N
 108     |
 109     |; ---- interrupts --------------------------------------------------------------
 110     |P2A        := IPL2_N
 111     |P2A.CLKF    = BCLK
 112     |P2B        := P2A
 113     |P2B.CLKF    = BCLK
 114     |P1A        := IPL1_N
 115     |P1A.CLKF    = BCLK
 116     |P1B        := P1A
 117     |P1B.CLKF    = BCLK
 118     |P0A        := IPL0_N
 119     |P0A.CLKF    = BCLK
 120     |P0B        := P0A
 121     |P0B.CLKF    = BCLK
 122     |
 123     |IPL2O_N    := /RSTI_N + P2A * P2B + IPL2O_N * (P2A :+: P2B)
 124     |IPL2O_N.CLKF = BCLK
 125     |IPL1O_N    := /RSTI_N + P1A * P1B + IPL1O_N * (P1A :+: P1B)
 126     |IPL1O_N.CLKF = BCLK
 127     |IPL0O_N    := /RSTI_N + P0A * P0B + IPL0O_N * (P0A :+: P0B)
 128     |IPL0O_N.CLKF = BCLK
 129     |
 130     |; ---- expansion bus request / grant ----------------------------------------------
 131     |KR         := /EXTBR_N * DISABLE_N
 132     |KR.CLKF     = BCLK
 133     |BG_N       := KR + /EXTBG_N
 134     |BG_N.CLKF   = BCLK
 135     |/EXTBG_N   := KR * BG_N * BB_N * CYC_N
 136     |EXTBG_N.CLKF = BCLK
 137     |
 138     |; ---- refresh timer from the E clock (not gated by reset) ------------------------
 139     |E1         := ECLK
 140     |E1.CLKF     = BCLK
 141     |E2         := E1
 142     |E2.CLKF     = BCLK
 143     |EC0        := EC0 :+:  
 143  s1 |(E1 * /E2)
 143     |
 144     |EC0.CLKF    = BCLK
 145     |EC1        := EC1 :+: (EC0 *  
 145  s1 |(E1 * /E2)
 145     |                                   )
 146     |EC1.CLKF    = BCLK
 147     |EC2        := EC2 :+: (EC1 * EC0 *  
 147  s1 |(E1 * /E2)
 147     |                                         )
 148     |EC2.CLKF    = BCLK
 149     |/REFREQ_N  :=  
 149  s1 |(E1 * /E2)
 149     |                     * EC2 * EC1 * EC0
 150     |REFREQ_N.CLKF = BCLK

