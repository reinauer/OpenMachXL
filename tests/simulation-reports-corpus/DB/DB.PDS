;MACHXL Design Description

;---------------------------------- Declaration Segment ------------
   TITLE MACH 445/465 Demo Board
 PATTERN DB.pds
REVISION 0.3
  AUTHOR J. ENGINEER
 COMPANY AMD - MACH Product Planning
    DATE 1/24/94
;   org 12/17/93 (C) Copyright AMD.

CHIP  _db_mach  MACH445

;---------------------------------- PIN Declarations ---------------
PIN 93,94,95,96,97,98,99,100    swc[0..7]
PIN 43,44,45,46,47,48,49,50     hdr[0..7] REG
PIN 62,61,60,59,58,57,56,55     hdr[8..15] REG
PIN 69,70,71,72,73,74,75,76     led[0..7] REG
PIN 12,11,10,9,8,7,6,5          PIO[8..15]                                       ;
PIN 19,20,21,22,23,24,25,26     IDB[0..7]                                        ;


PIN 88 clks Comb
PIN 13 clk0 
PIN  4 /rst     ; Active low

;-------------------------------------------------------------------
PIN  38         /PIACS    ; 29k write / readback reg access
PIN  37         /PIAOE    ;
PIN  36         /PIAWE    ;
PIN  35         A2        ;
PIN  34         A3        ;

;-------------------------------------------------------------------
;Controls
; swc[0], swc[1] - shifting pattern of LED's - up/dn/in/out sequences
; swc[6] -    on - blindingly fast - All LED's on dimly
; swc[7] -    on - fast shift
; swc[6/7] - off - real slow - 1x second
;-------------------------------------------------------------------

NODE 33, 18, 32, 31, 30, 29, 28, 27     breg[0..7]  reg
NODE 26, 25, 24, 23, 22, 21, 20, 19     breg[8..15] reg
NODE 117, 119, 118, 116, 115            brg2[0..4]  reg
GROUP MACH_SEG_b breg[0..15]
;-------------------------------------------------------------------
SIGNATURE     = NICK ;  JTAG USERCODE

;----------------------------------- Boolean Equation Segment ------
EQUATIONS


;-------------------------------------------------------------------
;LED's - OUTPUT BLOCK
if (Rst * /Rst) then begin led[0..7]:=#hFF end  ; active high logic

if (/Hdr[0]*/Hdr[1]*/Hdr[2]*/Hdr[3]*/hdr[4]*/Hdr[5]*/Hdr[6]*/hdr[7])
 then begin
    case (swc[1..0])
       begin
          0: begin led[0..7] := led[3,0..2,2..0,3] end ; Data shift mode in
          1: begin led[0..7] := led[1..3,0,0,4..6] end ; Data shift mode out
          2: begin led[0..7] := led[7,0..6       ] end ; Data shift mode dn
          3: begin led[0..7] := led[1..7,0       ] end ; Data shift mode up
       end
  end

; LED Notes:
; LED is on if reg contains logic 0. Reset turns on LED[0].
; /Hdr[0..7] when part is reset & no data written by 29k -> do shifts.

;-------------------------------------------------------------------
led[7..0].clkf = clks    led[7..1].setf = rst    led[7..1].rstf = gnd ; off
                         led[   0].rstf = rst    led[   0].setf = gnd ; on!
;-------------------------------------------------------------------
; Clock divider chain - 2 segments
; 16-bit counter breg[0..15] forms majority of divider.
;  5-bit counter brg2[0.. 4] is additional part
; Comb macrocell clks collects 3 different clock generators - OR function.
; Register setf & rstf connections allow shorter test vector sequences.
;-------------------------------------------------------------------
clks = swc[6]*/swc[7]*breg[15]*brg2[1]       + /swc[6] * clk0
    +  swc[6]* swc[7]*brg2[0]*brg2[1]*brg2[2]*brg2[3]*brg2[4]*breg[15]
;-------------------------------------------------------------------
 breg[0..15].clkf=CLK0     breg[2..14 ].setf=RST     breg[2..14 ].rstf=gnd
                           breg[0,1,15].rstf=RST     breg[0,1,15].setf=gnd
;breg[0..15].clkf=CLK0     breg[0..15].rstf=RST      breg[0..15].setf=gnd
;---------------------------------------------------------------
brg2[0..4].clkf=CLK0      brg2[0,2..4].setf=GND      brg2[0,2..4].rstf=gnd
                          brg2[1].setf=rst           brg2[1].rstf=gnd
;---------------------------------------------------------------

;Count up terms
breg[ 0].T:=vcc
breg[ 1].T:=breg[0]
breg[ 2].T:=breg[0]*breg[1]
breg[ 3].T:=breg[0]*breg[1]*breg[2]
breg[ 4].T:=breg[0]*breg[1]*breg[2]*breg[3]
breg[ 5].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]
breg[ 6].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]
breg[ 7].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]
breg[ 8].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]

breg[ 9].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]
breg[10].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]*breg[9]
breg[11].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]*breg[9]*breg[10]
breg[12].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]*breg[9]*breg[10]*breg[11]
breg[13].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]*breg[9]*breg[10]*breg[11]*breg[12]
breg[14].T:=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]*breg[9]*breg[10]*breg[11]*breg[12]*breg[13]
breg[15] :=breg[0]*breg[1]*breg[2]*breg[3]*breg[4]*breg[5]*breg[6]*breg[7]
        *breg[8]*breg[9]*breg[10]*breg[11]*breg[12]*breg[13]*breg[14]*/clk0
;-------------------------------------------------------------------

brg2[ 0].T:=breg[15]
brg2[ 1].T:=breg[15]*brg2[0]
brg2[ 2].T:=breg[15]*brg2[0]*brg2[1]
brg2[ 3].T:=breg[15]*brg2[0]*brg2[1]*brg2[2]            + clks*swc[7]
brg2[ 4].T:=breg[15]*brg2[0]*brg2[1]*brg2[2]*brg2[3]    + clks*swc[7]

;---------------------------------------------------------------

;-------------------------------------------------------------------
; THIS LOGIC FORMS A READ BACK REGISTER AT ADDRESS = 0X2. THE READ FUNCTION
; WILL BE LATER ON IN THE EQUATIONS

Hdr[0..7].RSTF = RST

Hdr[0..7].CLKF = PIACS*PIAWE*A3*/A2     ; Use w/ 29k
Hdr[0..7] = IDB[0..7]                   ; Use w/ 29k

;;Hdr[0..7] =  /swc[6]          ; Used for stand alone testing w/o 29k
;;Hdr[0..7].CLKF = clks         ; Used for stand alone testing w/o 29k

;-------------------------------------------------------------------
; THIS LOGIC FORMS A COMBITORIAL DRIVER FOR THE LEDS BASED ON THE READBACK
; REGISTER AND THE SWITCH POSITION.

LED[0..7] = Swc[0..7] * Hdr[0..7]

;-------------------------------------------------------------------
; AT ADDRESS 0X2 WE WILL READ BACK THE HEADER REGISTER AND AT 0X3 WE WILL
; READ THE SWITCH ARRAY.

IDB[0..7].TRST = PIACS*PIAOE*A3
IDB[0..7] = /A2 * Hdr[0..7] + A2 * Hdr[0..7]

;-------------------------------------------------------------------

;------------------------ Simulation Segment -----------------------
SIMULATION
Trace_on led[7..0] CLK0 RST swc[0..1,6,7] breg[0,1,14,15] brg2[0..4] clks

;-------------------------------------------------------------------
setf /swc[0..1,6,7] /rst /clk0

setf  rst
clockf clk0                     ; Reset the registers
setf /rst
setf swc[0,1] /swc[6]           ; Do tests is 1x clock mode!

;-------------------------------------------------------------------
for i := 1 to 8 do begin clockf clk0 end

setf  swc[1]  /swc[0] rst setf /rst   for i := 1 to 8 do begin clockf clk0 end
setf /swc[1]   swc[0] rst setf /rst   for i := 1 to 8 do begin clockf clk0 end
setf /swc[1]  /swc[0] rst setf /rst   for i := 1 to 8 do begin clockf clk0 end

; Optional tests for clock divider - low speed modes
;;setf  swc[6]
;;setf /swc[7]
;;setf  swc[1]  /swc[0] rst setf /rst  for i := 1 to 8 do begin clockf clk0 end
;;setf  swc[1]   swc[0] rst setf /rst  for i := 1 to 5 do begin clockf clk0 end
;;setf /swc[1]   swc[0] rst setf /rst  for i := 1 to 5 do begin clockf clk0 end
;;setf  swc[1]  /swc[0] rst setf /rst  for i := 1 to 5 do begin clockf clk0 end
;;setf  swc[7]
;;setf  swc[1]  /swc[0] rst setf /rst  for i := 1 to 5 do begin clockf clk0 end
;;Setf rst setf /rst      ; All done Reset device

trace_off
;-------------------------------------------------------------------

