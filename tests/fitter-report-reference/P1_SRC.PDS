;MACHXL Design Description

;---------------------------------- Declaration Segment ------------
TITLE    Cascaded Data Path Benchmark for PEP
PATTERN  0
REVISION 0
AUTHOR   J. ENGINEER
COMPANY  AMD
DATE     1/15/93
; Org: 05/12/92

CHIP  _d_path_c  MACH435

;---------------------------------- PIN Declarations ---------------
PIN  ?          id[23..0]
PIN  ?          sel[1..0]
PIN  ?          S_L
PIN  ?          clk
PIN  ?          rst

PIN  ?          ipd[7..0]
;-------------------------------------------------------------------
PIN  ?          q_x[7..0]   REGISTERED
NODE ?          m_x[7..0]   REGISTERED
;-------------------------------------------------------------------

;----------------------------------- Boolean Equation Segment ------
EQUATIONS

;-------------------------------------------------------------------
; Instance 0
;-------------------------------------------------------------------
; Input Select

  case (sel[1],sel[0])
       begin
       0: begin m_x[7..0] := ipd[ 7.. 0] end
       1: begin m_x[7..0] :=  id[ 7.. 0] end
       2: begin m_x[7..0] :=  id[15.. 8] end
       3: begin m_x[7..0] :=  id[23..16] end
       end

;-------------------------------------------------------------------
;OUTPUT BLOCK

  if S_L then
       begin    ; Data shift mode
               q_x[7] := q_x[6]         q_x[6] := q_x[5]
               q_x[5] := q_x[4]         q_x[4] := q_x[3]
               q_x[3] := q_x[2]         q_x[2] := q_x[1]
               q_x[1] := q_x[0]         q_x[0] := q_x[7]
       end
    else
       begin    ; Data load
               q_x[7..0] := m_x[7..0]
       end
;-------------------------------------------------------------------
q_x[7..0].clkf = clk    q_x[7..0].rstf = rst    q_x[7..0].setf = gnd
m_x[7..0].clkf = clk    m_x[7..0].rstf = rst    m_x[7..0].setf = gnd
;-------------------------------------------------------------------


;----------------------------------- Simulation Segment ------------
SIMULATION

Trace_on q_x[7..0] sel[1..0] CLK RST S_L
        id[23..0] ipd[7..0]

; Set the input data to:
;
SETF    ipd[7..0]  = #H01 
        id[23..16] = #H80 
        id[15..8]  = #H08 
        id[7..0]   = #H10 

setf  /S_L /clk /sel[1..0] rst
setf /rst                      ;Reset registers

Check /Q_x[7..0]       ; Zeros

;-------------------------------------------------------------------
for x:=0 to 2 do begin clockf clk end; Mux and load the registers with idp[7..0]

Check Q_x[7..0]=#H01                           ; idp value              

setf S_L
for i := 1 to 7 do begin clockf clk end         ; Shift q_x[7..0] 7 times
Check Q_x[7..0]=#H80                     ; value shifted

;-------------------------------------------------------------------
setf sel[1] /sel[0]           ; Prepare to Mux through id[15..8]
clockf clk                    ; Shift q_x[7..0] and load id into m_x

setf /S_L
for x:=0 to 2 do begin clockf clk end       ; Load id[15..8] into q_x[7..0]
Check Q_x[7..0]=#H08                    ; id[15..8] value 

setf S_L                      ; Prepare to shift
for i := 1 to 7 do begin clockf clk end         ; Shift q_x[7..0] 7 times
Check Q_x[7..0]=#H04                     ; value shifted

;-------------------------------------------------------------------
setf sel[1] sel[0]            ; Prepare to mux through id[23..16]
clockf clk                    ; Shift q_x[7..0] and load id[23..16] into m_x

setf /S_L
for x:=0 to 2 do begin clockf clk end                   ; Load id[23..16] into q_x[7..0]
Check Q_x[7..0]=#h80        ; id [23..16] value  

setf S_L                      ; Prepare to shift
for i := 1 to 7 do begin clockf clk end         ; Shift q_x[7..0] 7 times
Check Q_x[7..0]=#H40                     ; value shifted

;-------------------------------------------------------------------
setf /sel[1] sel[0]           ; Prepare to mux id[7..0]
clockf clk                    ; Shift q_x[7..0] and load id[7..0] to m_x
       
setf /S_L
clockf clk                    ; Load id[7..0] to q_x[7..0]
Check Q_x[7..0]=#H10        ; id [7..0] value    

setf S_L                      ; Prepare to shift
for i := 1 to 7 do begin clockf clk end         ; Shift q_x[7..0] 7 times
Check Q_x[7..0]=#H08             ; value shifted

setf /sel[1..0]
clockf clk

trace_off
;-------------------------------------------------------------------

