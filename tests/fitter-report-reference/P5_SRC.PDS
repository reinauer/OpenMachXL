; MACHXL Design description

; -----------------------Declaration Segment ------------
   TITLE Arithmetic - PREP Benchmark #5
 PATTERN P5.PDS
REVISION A
  AUTHOR J. ENGINEER
 COMPANY ADVANCED MICRO DEVICES, INC.
    DATE 21 Jan 1993

CHIP   Arithmetic      MACH435
;----------------------------------- Boolean Equation Segment ------

Pin  ? CLK              Pin  ? RST              pin  ? MAC

PIN  ? A_x[3..0]
PIN  ? B_x[3..0]

;-------------------------------------------------------------------
PIN  ? Q_x[7..0]  Reg
Node ? W_x[7..1]  comb          Node ? T_x[7..2] comb
NODE ? P_x[3,5]   comb          NODE ? G_x[3,5]  comb
NODE ? C_x[1..5]  comb
NODE ? Z_x[3,4]   comb
NODE ? Y_x[4,5]   comb
;-------------------------------------------------------------------

;---------------------------------------------------------------
;;NODE ? P_x[7]    comb          NODE ? G_x[7]    comb   ; Not used
;;PIN  ? C_x[7]    comb          PIN  ? C_x_IN           ; Not used

EQUATIONS;


;---------------------------------------------------------------
; Instance 0
;---------------------------------------------------------------
; Wallace tree implementation of Carry-save Multiplier array
;  Ref: Intro to Arithmetic - Wasser & Flynn
;       MMI PLE Handbook
; Impl: Nick Schmitz
; Date: 1/12/93

;---------------------------------------------------------------
; Partial Products            +-p30
;                       p31-+ | p21-+   p20-+
;               p32-+   p22-+ | p12-+   p11-+   p10-+
;       p33-+   p23-+   p13-+ | p03-+   p02-+   p01-+   p00
;  k7    k6-+    k5-+  +-k4 | +--k3 |    k2 |    k1 |    k0
;---------------------------------------------------------------
;B k7    w6------w5-+  +-w4 | |  w3-+  k/w2------w1-+   p00
;A t7----t6-+   *t5----+-t4-+ |  t3------t2-+    k1      k0
;                y5----+-y4   +-k/w2
;                        z4---+--z3*             * Extra Inputs
;---------------------------------------------------------------
; Look-up functions to sum partial products
; p10 & p01    k1->adder
W_x[1]= (A_x[0]*B_x[1])*/(A_x[1]*B_x[0]) ; 1
      +/(A_x[0]*B_x[1])* (A_x[1]*B_x[0])

;       (A_x[0]*B_x[1])* (A_x[1]*B_x[0]) ; 2
W_x[2]= (A_x[0]*B_x[1])* (A_x[1]*B_x[0]) * /(MAC * Q_x[2])
    + /((A_x[0]*B_x[1])* (A_x[1]*B_x[0]))*  (MAC * Q_x[2])

;---------------------------------------------------------------
; p02, p11, p20
T_x[2]= (A_x[0]*B_x[2])* (A_x[1]*B_x[1])* (A_x[2]*B_x[0]) ; 3
      + (A_x[0]*B_x[2])*/(A_x[1]*B_x[1])*/(A_x[2]*B_x[0]) ; 1
      +/(A_x[0]*B_x[2])* (A_x[1]*B_x[1])*/(A_x[2]*B_x[0])
      +/(A_x[0]*B_x[2])*/(A_x[1]*B_x[1])* (A_x[2]*B_x[0])

T_x[3]= (A_x[0]*B_x[2])* (A_x[1]*B_x[1])* (A_x[2]*B_x[0]) ; 3
      + (A_x[0]*B_x[2])* (A_x[1]*B_x[1])*/(A_x[2]*B_x[0]) ; 2
      + (A_x[0]*B_x[2])*/(A_x[1]*B_x[1])* (A_x[2]*B_x[0])
      +/(A_x[0]*B_x[2])* (A_x[1]*B_x[1])* (A_x[2]*B_x[0])

;---------------------------------------------------------------
; p12, p21, p03
W_x[3]= (A_x[1]*B_x[2])* (A_x[0]*B_x[3])* (A_x[2]*B_x[1]) ; 3
      + (A_x[1]*B_x[2])*/(A_x[0]*B_x[3])*/(A_x[2]*B_x[1]) ; 1
      +/(A_x[1]*B_x[2])* (A_x[0]*B_x[3])*/(A_x[2]*B_x[1])
      +/(A_x[1]*B_x[2])*/(A_x[0]*B_x[3])* (A_x[2]*B_x[1])

W_x[4]= (A_x[1]*B_x[2])* (A_x[0]*B_x[3])* (A_x[2]*B_x[1]) ; 3
      + (A_x[1]*B_x[2])* (A_x[0]*B_x[3])*/(A_x[2]*B_x[1]) ; 2
      + (A_x[1]*B_x[2])*/(A_x[0]*B_x[3])* (A_x[2]*B_x[1])
      +/(A_x[1]*B_x[2])* (A_x[0]*B_x[3])* (A_x[2]*B_x[1])

;---------------------------------------------------------------
; p13, p22, p31
T_x[4]= (A_x[1]*B_x[3])* (A_x[2]*B_x[2])* (A_x[3]*B_x[1]) ; 3
      + (A_x[1]*B_x[3])*/(A_x[2]*B_x[2])*/(A_x[3]*B_x[1]) ; 1
      +/(A_x[1]*B_x[3])* (A_x[2]*B_x[2])*/(A_x[3]*B_x[1])
      +/(A_x[1]*B_x[3])*/(A_x[2]*B_x[2])* (A_x[3]*B_x[1])

T_x[5]= (A_x[1]*B_x[3])* (A_x[2]*B_x[2])* (A_x[3]*B_x[1]) ; 3
      + (A_x[1]*B_x[3])* (A_x[2]*B_x[2])*/(A_x[3]*B_x[1]) ; 2
      + (A_x[1]*B_x[3])*/(A_x[2]*B_x[2])* (A_x[3]*B_x[1])
      +/(A_x[1]*B_x[3])* (A_x[2]*B_x[2])* (A_x[3]*B_x[1])

;---------------------------------------------------------------
; p23, p32, k5
W_x[5]= (A_x[2]*B_x[3])* (A_x[3]*B_x[2])* (MAC*Q_x[5]) ; 3
      + (A_x[2]*B_x[3])*/(A_x[3]*B_x[2])*/(MAC*Q_x[5]) ; 1
      +/(A_x[2]*B_x[3])* (A_x[3]*B_x[2])*/(MAC*Q_x[5])
      +/(A_x[2]*B_x[3])*/(A_x[3]*B_x[2])* (MAC*Q_x[5])

W_x[6]= (A_x[2]*B_x[3])* (A_x[3]*B_x[2])* (MAC*Q_x[5]) ; 3
      + (A_x[2]*B_x[3])* (A_x[3]*B_x[2])*/(MAC*Q_x[5]) ; 2
      + (A_x[2]*B_x[3])*/(A_x[3]*B_x[2])* (MAC*Q_x[5])
      +/(A_x[2]*B_x[3])* (A_x[3]*B_x[2])* (MAC*Q_x[5])

;---------------------------------------------------------------
; p33 & k6
T_x[6]= (A_x[3]*B_x[3])*/(MAC*Q_x[6]) ;1
      +/(A_x[3]*B_x[3])* (MAC*Q_x[6])
      +/(A_x[3]*B_x[3]*MAC*Q_x[6]) *(W_x[5]*T_x[5]*C_x[4]*Y_x[5])

T_x[7]= (A_x[3]*B_x[3])* (MAC*Q_x[6]);2
      + (A_x[3]*B_x[3]*MAC*Q_x[6]) *(W_x[5]*T_x[5]*C_x[4]*Y_x[5])

W_x[7]= MAC*Q_x[7]
;---------------------------------------------------------------

;---------------------------------------------------------------
; p30, k3, k2/w2
Z_x[3]=
  (A_x[3]*B_x[0])* (MAC*Q_x[3])* (A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2]) ; 3
+ (A_x[3]*B_x[0])*/(MAC*Q_x[3])*/(A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2]) ; 1
+/(A_x[3]*B_x[0])* (MAC*Q_x[3])*/(A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2])
+/(A_x[3]*B_x[0])*/(MAC*Q_x[3])* (A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2])

Z_x[4]=
  (A_x[3]*B_x[0])* (MAC*Q_x[3])* (A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2]) ; 3
+ (A_x[3]*B_x[0])* (MAC*Q_x[3])*/(A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2]) ; 2
+ (A_x[3]*B_x[0])*/(MAC*Q_x[3])* (A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2])
+/(A_x[3]*B_x[0])* (MAC*Q_x[3])* (A_x[0]*B_x[1]*A_x[1]*B_x[0]*MAC*Q_x[2])

;---------------------------------------------------------------
; w4 t4, k4
Y_x[4]= (W_x[4])* (T_x[4])* (MAC*Q_x[4]) ; 3
      + (W_x[4])*/(T_x[4])*/(MAC*Q_x[4]) ; 1
      +/(W_x[4])* (T_x[4])*/(MAC*Q_x[4])
      +/(W_x[4])*/(T_x[4])* (MAC*Q_x[4])

Y_x[5]= (W_x[4])* (T_x[4])* (MAC*Q_x[4]) ; 3
      + (W_x[4])* (T_x[4])*/(MAC*Q_x[4]) ; 2
      + (W_x[4])*/(T_x[4])* (MAC*Q_x[4])
      +/(W_x[4])* (T_x[4])* (MAC*Q_x[4])
;---------------------------------------------------------------

;---------------------------------------------------------------
;    TITLE 8 Bit Full Adder (2 bit with lookahead carry techniques)
;  PATTERN EXADD8.PDS
; REVISION A
;   AUTHOR George Landers & Nick Schmitz
;  COMPANY Advanced Micro Devices, Inc.
;     DATE 07/30/90
;---------------------------------------------------------------
; Adapted for use with multiplier - Vectorize & extra inputs

; Reg output for Prep
Q_x[7..0].clkf=CLK        Q_x[7..0].rstf=RST        Q_x[7..0].setf=gnd

;---------------------------------------------------------------
P_x[3] = T_x[2] * T_x[3]
   + T_x[2] * W_x[3]
   + W_x[2] * T_x[3]
   + W_x[2] * W_x[3]

   + T_x[2] * Z_x[3]    ; Extra input Z_x[3]
   + W_x[2] * Z_x[3]

P_x[5] = Y_x[4] * Y_x[5]
   + Y_x[4] * W_x[5]
   + Z_x[4] * Y_x[5]
   + Z_x[4] * W_x[5]

   + Y_x[4] * T_x[5]  ; Extra input T_x[5]
   + Z_x[4] * T_x[5]

   + W_x[5] * T_x[3] * W_x[3] * Z_x[3] * C_x[2]
   + Y_x[5] * T_x[3] * W_x[3] * Z_x[3] * C_x[2]

; P_x[7] = T_x[6] * T_x[7]      ; not used
;   + T_x[6] * W_x[7]
;   + W_x[6] * T_x[7]
;   + W_x[6] * W_x[7]

;---------------------------------------------------------------
G_x[3] = T_x[3] * W_x[3]
   + T_x[2] * W_x[2] * T_x[3]
   + T_x[2] * W_x[2] * W_x[3]

   + T_x[3] * Z_x[3]    ; Extra input Z_x[3]
   + W_x[3] * Z_x[3]
   + T_x[2] * W_x[2] * Z_x[3]

G_x[5] = Y_x[5] * W_x[5]
   + Y_x[4] * Z_x[4] * Y_x[5]
   + Y_x[4] * Z_x[4] * W_x[5]

   + Y_x[5] * T_x[5]    ; Extra input T_x[5]
   + W_x[5] * T_x[5]
   + Y_x[4] * Z_x[4] * T_x[5]

; G_x[7] = T_x[7] * W_x[7]      ; not used
;   + T_x[6] * W_x[6] * T_x[7]
;   + T_x[6] * W_x[6] * W_x[7]

;---------------------------------------------------------------
C_x[1] = (MAC * Q_x[1]) * W_x[1]
   + (MAC * Q_x[0]) * (A_x[0] * B_x[0]) * (MAC * Q_x[1])
   + (MAC * Q_x[0]) * (A_x[0] * B_x[0]) * W_x[1]

;   + C_x_IN * T_x[0] * T_x[1]          ; not used
;   + C_x_IN * T_x[0] * W_x[1]
;   + C_x_IN * W_x[0] * T_x[1]
;   + C_x_IN * W_x[0] * W_x[1]

C_x[2] = ((T_x[2]*W_x[2]) + (T_x[2]*C_x[1]) + (W_x[2]*C_x[1]))

C_x[3] = (G_x[3]
   + C_x[1] * P_x[3]
   ) * / (T_x[3] * W_x[3] * C_x[2] * Z_x[3])

C_x[4] = ((Y_x[4]*Z_x[4]) + (Y_x[4]*C_x[3]) + (Z_x[4]*C_x[3]))
  + (T_x[3] * W_x[3] * C_x[2] * Z_x[3])

C_x[5] = (G_x[5]
   + G_x[3] * P_x[5]
   + C_x[1] * P_x[3] * P_x[5]
   ) * /(W_x[5] * Y_x[5] * C_x[4] * T_x[5])


; C_x[7] = G_x[7]       ; not used
;   + G_x[5] * P_x[7]
;   + G_x[3] * P_x[5] * P_x[7]
;   + C_x[1] * P_x[3] * P_x[5] * P_x[7]

;---------------------------------------------------------------
Q_x[0] = (MAC * Q_x[0]) :+: (A_x[0] * B_x[0])    ; :+: C_x_IN   ; not used
Q_x[1] = (MAC * Q_x[1]) :+: W_x[1] :+: ((MAC * Q_x[0])*(A_x[0] * B_x[0]))
                ; (+ (T_x[0]*C_x_IN) + (W_x[0] *C_x_IN))        ; not used
Q_x[2] = T_x[2] :+: W_x[2]       :+: C_x[1]
Q_x[3] = T_x[3] :+: W_x[3]       :+: C_x[2] :+: Z_x[3] ; Extra input Z_x[3]
Q_x[4] = Y_x[4] :+: Z_x[4]       :+: C_x[3]
Q_x[5] = Y_x[5] :+: W_x[5]       :+: C_x[4] :+: T_x[5] ; Extra input T_x[5]
Q_x[6] = T_x[6] :+: W_x[6]       :+: C_x[5]
Q_x[7] = T_x[7] :+: W_x[7]
        :+: ((T_x[6]*W_x[6]) + (T_x[6]*C_x[5]) + (W_x[6]*C_x[5]))
;---------------------------------------------------------------


;---------------------------------------------------------------
Simulation
; Simple vector set

Trace_on A_x[3..0] B_x[3..0] RST   CLK MAC  Q_x[7..0]

        Setf /RST   /CLK   /A_x[3..0] /B_x[3..0]   /MAC
        Setf Rst        Setf /RST
        Check /Q_x[7..0]

        setf /MAC
        clockf CLK      clockf CLK

;---------------------------------------------------------------
        Setf A_x[3..0]=#H2  B_x[3..0]=#H7   ; #h0E
        clockf CLK
        Check  Q_x[7..0]=#H0E    ;   /Q_x[7..4,0] Q_x[3,2,1]
        clockf CLK
        Check   Q_x[7..0]=#H0E    ;   /Q_x[7..4,0] Q_x[3,2,1]

        Setf MAC        clockf CLK      ; 14 + 14 = 28  #h1C
        Check   Q_x[7..0]=#H1C    ;   /Q_x[7..5,1,0] Q_x[4..2]

;---------------------------------------------------------------
        Setf     A_x[3..0]=#H1  B_x[3..0]=#H5   ;     A_x[0]  /A_x[1]   /B_x[1]  ; 28 + 1 * 5 =33 #h21
        clockf CLK
        Check   Q_x[7..0]=#H21    ;   /Q_x[7..6,4..1] Q_x[5,0]
        clockf CLK

        Setf Rst        Setf /RST
        Check /Q_x[7..0]

;---------------------------------------------------------------
        clockf CLK      Check /Q_x[7..3,1] Q_x[2,0]     ; 5
        clockf CLK      Check /Q_x[7..4,2,0] Q_x[3,1]   ; 10
        clockf CLK      Check /Q_x[7..4] Q_x[3..0]      ; 15
        clockf CLK      Check /Q_x[7..5,3,1,0] Q_x[4,2] ; 20

        setf A_x[2,0] /A_x[3,1] B_x[3,1] /B_x[2,0]      ; 20+5*10=70
        clockf CLK      Check /Q_x[7,5..3,0] Q_x[6,2,1] ; 70

        setf A_x[3,2] /A_x[1,0] B_x[3,1] /B_x[2,0]      ; 70+12*10=190
        clockf CLK      Check /Q_x[6,0] Q_x[7,5..1]     ; 190

;---------------------------------------------------------------
        setf A_x[3,2] /A_x[1,0] B_x[2,0] /B_x[3,1]      ; 190+12*5=250
        clockf CLK      Check /Q_x[2,0] Q_x[7..3,1]     ; 250

        setf A_x[0] /A_x[3..1] B_x[2,0] /B_x[3,1]       ; 250+1*5=255
        clockf CLK      Check  Q_x[7..0]                ; 255

;---------------------------------------------------------------
        Setf Rst        Setf /RST MAC
        Check /Q_x[7..0]

Trace_off
;---------------------------------------------------------------

