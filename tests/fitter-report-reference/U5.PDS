CHIP U5 MACH435
PIN 19 SIGA
PIN 33 SIGB
PIN 20 SIGC
PIN 23 CLK1
PIN 62 CLOCKIN
PIN 65 SIGE
PIN 66 SIGF
PIN 73 AR REG
PIN 79 AV REG
PIN 80 BA REG
PIN 12 BD REG
PIN 14 BG REG
PIN 15 BJ REG
PIN 16 BM REG
PIN 17 BP REG
PIN 18 BS REG
PIN 49 BV REG
PIN 51 CA REG
NODE ? N0 REG
NODE ? N1 REG
NODE ? N2 REG
NODE ? N3 REG
NODE ? N4 REG
EQUATIONS
AR.CLKF = CLOCKIN
AV.CLKF = CLOCKIN
AR := SIGE * SIGA + /SIGE * AR
AV := SIGE * SIGA + /SIGE * AV
BD.CLKF = CLK1
BD := N0
BG.CLKF = CLK1
BG := N1
BJ.CLKF = CLK1
BJ := N2
BM.CLKF = CLK1
BM := N3
BP.CLKF = CLK1
BP := N4
BS.CLKF = CLK1
BS := SIGA
BV.CLKF = CLK1
BV := SIGA
CA.CLKF = CLK1
CA := SIGA
BA.CLKF = CLK1
BA := SIGA
N0.CLKF = CLK1
N0 := VCC
N0.RSTF = BV
N1.CLKF = CLK1
N1 := VCC
N1.RSTF = BP
N2.CLKF = CLK1
N2 := VCC
N2.RSTF = BS
N3.CLKF = CLK1
N3 := VCC
N3.RSTF = BD
N4.CLKF = CLK1
N4 := VCC
N4.RSTF = BG
