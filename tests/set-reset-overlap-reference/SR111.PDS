CHIP SR111 MACH111
PIN ? CLK
PIN ? I0
PIN ? I1
PIN ? I2
PIN ? I3
PIN ? I4
PIN ? I5
PIN ? I6
PIN ? I7
PIN ? O2 REG
NODE ? N4 REG
PIN ? O5
PIN ? O9 REG
PIN ? XN13
EQUATIONS
O2 = /I0
O2.CLKF = CLK
N4 = /I0*/I0 + O2*/I2*I3
N4.CLKF = CLK
N4.SETF = /I7*I5*I3
O5 = /I0*N4*/I3 + N4*/I2 + I4*/I2*/I0
O9 = I5*I0
O9.CLKF = CLK
O9.RSTF = I5
XN13 = I0 * I5
