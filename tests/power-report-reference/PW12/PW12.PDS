N0:=X :+: (A0*/A1*/A2*/A3*/A4*A5+/A0*A1*A2*A3*/A4*A5+A0*A1*A2*/A3*/A4*A5+A0*/A1*A2*A3*A4*/A5+A0*/A1*/A2*A3*A4*A5+/A0*A1*A2*/A3*A4*A5+A0*A1*/A2*/A3*/A4*/A5+/A0*/A1*A2*/A3*/A4*A5+A0*/A1*A2*/A3*/A4*/A5)
