;---------------------------------- Declaration Segment ------------
TITLE     3 Bit T-Counter
PATTERN   1
REVISION  1
AUTHOR    Alex Marrero
COMPANY   AMD
DATE      9/5/94

CHIP  3COUNT_T  MACH111

;---------------------------------- PIN Declarations --------------


;----------------------------------- Boolean Equation Segment ------

PIN 35 CLK
PIN 4 ENABLE
PIN 3 RST
PIN 43 B[2] REGISTERED
PIN 2 B[1] REGISTERED
PIN 40 B[0] REGISTERED

EQUATIONS
;------------ T-FF


B[0].T := ENABLE       
B[1].T := ENABLE *B[0] 
B[2].T := ENABLE *B[0] * B[1]    

B[2..0].CLKF=CLK
B[2..0].RSTF=RST

;----------------------------------- Simulation Segment ------------
SIMULATION


TRACE_ON   B[2..0]  CLK RST ENABLE


SETF RST ENABLE
SETF /RST

CHECKQ /B[2..0]

FOR X:= 1 TO 10 DO
        BEGIN
             CLOCKF CLK
        END

CHECKQ  B[2..0] = #B010

TRACE_OFF


;-------------------------------------------------------------------
