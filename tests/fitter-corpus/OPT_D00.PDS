;Decoders are often used for memory addressing, where they select one of 
;several memory devices.  They can also be use to demultiplex data and 
;reroute clocks.
;---------------------------------- Declaration Segment ------------
TITLE   1 of 8 DECODER
PATTERN  1
REVISION 1
AUTHOR   J. ENGINEER
COMPANY  AMD
DATE    8/26/94

CHIP  decoder  MACH111

;---------------------------------- PIN Declarations --------------

PIN  ?          DATA[0..7] 
PIN  ?          SEL1                            
PIN  ?          SEL2
PIN  ?          SEL3 
PIN  ?          OUT[0..7]

EQUATIONS

OUT[0]   =        /SEL1*/SEL2*/SEL3*DATA[0] 
OUT[1]   =        /SEL1*/SEL2* SEL3*DATA[1]
OUT[2]   =        /SEL1* SEL2*/SEL3*DATA[2]
OUT[3]   =        /SEL1* SEL2* SEL3*DATA[3]
OUT[4]   =         SEL1*/SEL2*/SEL3*DATA[4] 
OUT[5]   =         SEL1*/SEL2* SEL3*DATA[5] 
OUT[6]   =         SEL1* SEL2*/SEL3*DATA[6] 
OUT[7]   =         SEL1* SEL2* SEL3*DATA[7] 

SIMULATION

TRACE_ON DATA[7..0] OUT[7..0] SEL1 SEL2 SEL3

SETF DATA[7..0]= #HFF ; Hex number

FOR X:=1 TO 3 DO
    BEGIN            
      SETF /SEL1 /SEL2 /SEL3
    END
CHECK OUT[0]

FOR X:=1 TO 3 DO
    BEGIN
      SETF /SEL1 /SEL2 SEL3
    END
CHECK OUT[1] 

FOR X:=1 TO 3 DO
    BEGIN
      SETF /SEL1 SEL2  /SEL3
    END
CHECK OUT[2] 

FOR X:=1 TO 3 DO
    BEGIN
      SETF /SEL1 SEL2  SEL3
    END
CHECK OUT[3] 

FOR X:=1 TO 3 DO
    BEGIN
      SETF SEL1 /SEL2  /SEL3
    END
CHECK OUT[4] 

FOR X:=1 TO 3 DO
    BEGIN
      SETF SEL1 /SEL2  SEL3
    END
CHECK OUT[5] 

TRACE_OFF
