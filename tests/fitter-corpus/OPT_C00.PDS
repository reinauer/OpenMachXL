;---------------------------------- Declaration Segment ------------
TITLE     3 Bits D-Counter
PATTERN   1
REVISION  1
AUTHOR    J. ENGINEER
COMPANY   AMD
DATE      8/26/94

CHIP  3COUNT_D  MACH111

;---------------------------------- PIN Declarations --------------
PIN  ?          CLK                                         ; INPUT
PIN  ?          ENABLE
PIN  ?          RST
PIN  ?          B[2..0]     REGISTERED                      ; OUTPUT


;----------------------------------- Boolean Equation Segment ------

EQUATIONS
;------------ D-FF


B[0] := ENABLE*/B[0]        
B[1] := ENABLE*B[0] :+: B[1]
B[2] := ENABLE*B[0] * B[1]:+: B[2]    

B[2..0].CLKF=CLK
B[2..0].RSTF=RST

;----------------------------------- Simulation Segment ------------
SIMULATION


TRACE_ON   B[2..0]  CLK RST ENABLE


SETF RST ENABLE
SETF /RST

CHECKQ /B[2..0]

FOR X:= 1 TO 10 DO
        BEGIN
             CLOCKF CLK
        END

CHECKQ  B[2..0]= #B010

TRACE_OFF


;-------------------------------------------------------------------
